+def block_unit_lower_inverse(M):
+    """M^-1 for a unit lower triangular M [..., n, n], n a power of 2: [[A, 0], [B, D]]^-1 =
+    [[A^-1, 0], [-D^-1 B A^-1, D^-1]], A and D inverted together, log2 n levels of batched matmuls (as stable as
+    substitution; a power series in L is not: its partial powers overflow f32)."""
