diff --git a/syncer/client.py b/syncer/client.py
index eadd9bb..f8d6d70 100644
--- a/syncer/client.py
+++ b/syncer/client.py
@@ -12,8 +12,9 @@ class RetryError(RuntimeError):
 
 
 def retry_delays(policy):
-    """Seconds to wait before each retry, in order (max_attempts - 1 of them)."""
-    return [policy.delay] * (policy.max_attempts - 1)
+    """Seconds to wait before each retry, in order (max_attempts - 1 of them): exponential
+    backoff, backoff_base * 2**(n-1) before retry n, capped at backoff_max."""
+    return [min(policy.backoff_base * 2 ** n, policy.backoff_max) for n in range(policy.max_attempts - 1)]
 
 
 def call_with_retry(fn, policy, sleep=time.sleep, log=None):
