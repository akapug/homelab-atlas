     first. If some jobs can never become ready (they sit on or behind a
     dependency cycle), raises CycleError naming all of them, sorted.
     """
+    # Kahn's algorithm; the heap holds the ready jobs keyed by (-priority, declared position),
+    # so it pops exactly the job the rule above picks. O(E log V) instead of rescanning every
+    # pending job after each step.
+    position = {job.name: i for i, job in enumerate(jobs)}
+    waiting = [len(set(job.deps)) for job in jobs]
+    dependents = [[] for _ in jobs]
+    for i, job in enumerate(jobs):
+        for dep in set(job.deps):
+            dependents[position[dep]].append(i)
+    ready = [(-job.priority, i) for i, job in enumerate(jobs) if not waiting[i]]
+    heapq.heapify(ready)
     done = []
-    pending = list(jobs)
-    while pending:
-        ready = [j for j in pending if all(d in done for d in j.deps)]
-        if not ready:
-            raise CycleError(sorted(j.name for j in pending))
-        best = ready[0]
-        for j in ready[1:]:
-            if j.priority > best.priority:
-                best = j
-        done.append(best.name)
-        pending.remove(best)
+    while ready:
+        _, i = heapq.heappop(ready)
+        done.append(jobs[i].name)
+        for k in dependents[i]:
+            waiting[k] -= 1
+            if not waiting[k]:
+                heapq.heappush(ready, (-jobs[k].priority, k))
+    if len(done) < len(jobs):
+        ran = set(done)
+        raise CycleError(sorted(job.name for job in jobs if job.name not in ran))
