--- a/shop/money.py
+++ b/shop/money.py
@@ -4,12 +4,13 @@ SYMBOLS = {"USD": "$", "EUR": "€", "GBP": "£", "JPY": "¥"}
 DECIMALS = {"JPY": 0}
 
 
-def fmt(cents, currency="USD", show_symbol=True, pad=0):
+def format_cents(cents, *, currency="USD", show_symbol=True, pad=0):
     """Format an amount of minor units for display.
 
-    fmt(123456) -> '$1,234.56'; fmt(-5, 'EUR') -> '-€0.05';
-    fmt(1500, 'JPY', False) -> '1,500'. A nonzero pad right-aligns the
-    result to that width. Unknown currencies use the code as a prefix.
+    format_cents(123456) -> '$1,234.56';
+    format_cents(-5, currency='EUR') -> '-€0.05';
+    format_cents(1500, currency='JPY', show_symbol=False) -> '1,500'.
+    A nonzero pad right-aligns the result to that width. Unknown currencies use the code as a prefix.
     """
     places = DECIMALS.get(currency, 2)
     sign = "-" if cents < 0 else ""
