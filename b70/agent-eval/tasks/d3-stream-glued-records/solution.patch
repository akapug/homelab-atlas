+    def test_escaped_backslash_split_across_pieces(self):
+        # The second backslash of \\ starts the next piece; it must not escape the LF after it.
+        decoder = Decoder()
+        records = decoder.feed("88213\tD:\\\\exports\\") + decoder.feed("\\\n88214\tx\n") + decoder.close()
+        self.assertEqual(records, [["88213", "D:\\exports\\"], ["88214", "x"]])
+
+    def test_every_split_of_backslash_runs(self):
+        records = [["a\\"], ["\\\\"], ["\\", "\\\\\\"], [None, "\\N"], ["b"]]
+        text = "".join(map(encode_record, records))
+        for cut in range(len(text) + 1):
+            with self.subTest(cut=cut):
+                decoder = Decoder()
+                self.assertEqual(decoder.feed(text[:cut]) + decoder.feed(text[cut:]) + decoder.close(), records)
