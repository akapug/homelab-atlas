--- a/logstat/reader.py
+++ b/logstat/reader.py
@@ -1,4 +1,5 @@
 """Reading log files, plain or gzip-compressed, as lines of text."""
+import codecs
 import gzip
 
 
@@ -6,9 +7,13 @@ def open_log(path):
     """Yield the lines of a log file without their line endings.
 
     The file is read as bytes and decoded one line at a time, so a corrupt
-    byte costs one replacement character instead of the whole file.
+    byte costs one replacement character instead of the whole file. Lines may
+    end in LF or CRLF, and the file may start with a UTF-8 byte-order mark
+    (Windows tools write both); neither is part of the text.
     """
     opener = gzip.open if path.endswith(".gz") else open
     with opener(path, "rb") as f:
-        for raw in f:
-            yield raw.decode("utf-8", errors="replace").rstrip("\n")
+        for n, raw in enumerate(f):
+            if n == 0 and raw.startswith(codecs.BOM_UTF8):
+                raw = raw[len(codecs.BOM_UTF8):]
+            yield raw.decode("utf-8", errors="replace").rstrip("\r\n")
