diff --git a/build.sh b/build.sh
index 182d66d..47d7535 100755
--- a/build.sh
+++ b/build.sh
@@ -1,7 +1,9 @@
 #!/usr/bin/env bash
 # build.sh - turn configs/*.conf into the release bundle dist/bundle.tar.gz.
 # Every step's output also goes to dist/build.log, which CI keeps as an artifact.
-set -e
+# Any failing step fails the build: pipefail makes `step | tee` report the step's
+# status, not tee's, and set -e then stops the script.
+set -eo pipefail
 cd "$(dirname "$0")"
 
 out=dist
@@ -15,7 +17,9 @@ python3 tools/gen.py configs "$stage" 2>&1 | tee -a "$log"
 
 echo "== validate" | tee -a "$log"
 for f in "$stage"/*.json; do
-    python3 tools/validate.py "$f" >>"$log" 2>&1 && echo "  ok $(basename "$f")" | tee -a "$log"
+    # Not `validate && echo ok`: set -e ignores a failure on the left of &&.
+    python3 tools/validate.py "$f" 2>&1 | tee -a "$log"
+    echo "  ok $(basename "$f")" | tee -a "$log"
 done
 
 echo "== package" | tee -a "$log"
