diff --git a/orderexp/store.py b/orderexp/store.py
index fdfb329..beb26af 100644
--- a/orderexp/store.py
+++ b/orderexp/store.py
@@ -29,11 +29,15 @@ class Store:
         return self.db.execute("SELECT COUNT(*) FROM orders").fetchone()[0]
 
     def changed_since(self, since, limit):
-        """Up to `limit` orders changed after `since` (None: from the beginning), oldest first,
-        as (id, ref, updated_at, total_cents) tuples."""
+        """Up to `limit` orders after position `since`, an (updated_at, id) pair (None: from the
+        beginning), in (updated_at, id) order, as (id, ref, updated_at, total_cents) tuples.
+
+        The id breaks ties: many orders can share one updated_at second, and a position made of
+        the timestamp alone would skip the rest of a burst that a page boundary splits."""
         if since is None:
-            sql, args = f"SELECT {COLUMNS} FROM orders ORDER BY updated_at LIMIT ?", (limit,)
+            sql, args = f"SELECT {COLUMNS} FROM orders ORDER BY updated_at, id LIMIT ?", (limit,)
         else:
-            sql = f"SELECT {COLUMNS} FROM orders WHERE updated_at > ? ORDER BY updated_at LIMIT ?"
-            args = (since, limit)
+            sql = (f"SELECT {COLUMNS} FROM orders WHERE updated_at > ? OR (updated_at = ? AND id > ?)"
+                   " ORDER BY updated_at, id LIMIT ?")
+            args = (since[0], since[0], since[1], limit)
         return self.db.execute(sql, args).fetchall()
