diff --git a/orderexp/checkpoint.py b/orderexp/checkpoint.py
index 597b165..476080b 100644
--- a/orderexp/checkpoint.py
+++ b/orderexp/checkpoint.py
@@ -4,15 +4,20 @@ import os
 
 
 def load(path):
-    """The saved position, or None if there is no checkpoint yet."""
+    """The saved (updated_at, id) position, or None if there is no checkpoint yet.
+
+    A checkpoint written before ids were recorded resumes at the start of its timestamp, so
+    orders that shared it are exported again rather than lost."""
     if not os.path.exists(path):
         return None
     with open(path) as f:
-        return json.load(f)["updated_at"]
+        data = json.load(f)
+    return data["updated_at"], data.get("id", 0)
 
 
 def save(path, position):
+    updated_at, order_id = position
     tmp = path + ".tmp"
     with open(tmp, "w") as f:
-        json.dump({"updated_at": position}, f)
+        json.dump({"updated_at": updated_at, "id": order_id}, f)
     os.replace(tmp, path)
