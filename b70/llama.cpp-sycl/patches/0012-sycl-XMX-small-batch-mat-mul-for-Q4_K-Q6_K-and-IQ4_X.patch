 // nibble mask of a weight word yields an fp16 pair in the B operand's order; rows >= ncols_y are 0
 static void xmx_convert_y(const float * x, sycl::half * y, int ncols, int ncols_y, int64_t stride_x,
@@ -53,6 +61,8 @@ static void xmx_convert_y(const float * x, sycl::half * y, int ncols, int ncols_
 
 // One lane's Q5_K block in the reorder layout: [qs 128][qh 32][scales 12][d, dmin] regions over all blocks.
 struct xmx_block_q5_K {
+    static constexpr bool uses_table = false;
+
     sycl::uint4 qs[8], qh[2];
     uint32_t    sc[3];
     sycl::half2 dm;
@@ -103,68 +113,247 @@ struct xmx_block_q5_K {
     }
 };
 
+// One lane's Q4_K block in the reorder layout: [qs 128][scales 12][d, dmin] regions over all blocks.
+// The codes sit as Q5_K's low bits do.
+struct xmx_block_q4_K {
+    static constexpr bool uses_table = false;
+
+    sycl::uint4 qs[8];
+    uint32_t    sc[3];
+    sycl::half2 dm;
+
+    void load(const uint8_t * base, size_t nblk, size_t bi) {
+        const sycl::uint4 * gqs = (const sycl::uint4 *) base;
+        const uint32_t *    gsc = (const uint32_t *) (base + (QK_K / 2) * nblk);
+        const sycl::half2 * gdm = (const sycl::half2 *) (base + (QK_K / 2 + K_SCALE_SIZE) * nblk);
+#pragma unroll
+        for (int i = 0; i < 8; ++i) {
+            qs[i] = gqs[bi * 8 + i];
+        }
+#pragma unroll
+        for (int i = 0; i < 3; ++i) {
+            sc[i] = gsc[bi * 3 + i];
+        }
+        dm = gdm[bi];
+    }
+
+    // the 16 weights of tile t (k = 16 t .. 16 t + 15), each group of 4 as (k0, k2, k1, k3)
+    void tile(int t, sycl::half * w) const {
+        const int  s = t / 2, kt = t % 2, p = s / 2;
+        const bool hi = s % 2;
+        uint8_t    sc6, mn6;
+        get_scale_min_k4(s, (const uint8_t *) sc, sc6, mn6);
+        const float       d = dm[0], dmin = dm[1];
+        const sycl::half2 a2((sycl::half) (d * sc6)), c2((sycl::half) (-dmin * mn6)), k1024((sycl::half) 1024.0f);
+        const uint32_t *  qs32 = (const uint32_t *) qs;
+#pragma unroll
+        for (int j = 0; j < 4; ++j) {
+            // a 4-bit code | 0x6400 is the fp16 value 1024 + code
+            const uint32_t ql = qs32[8 * p + 4 * kt + j];
+            const uint32_t v  = hi ? (ql >> 4) : ql;
+            const uint32_t u0 = (v & 0x000F000Fu) | 0x64006400u;
+            const uint32_t u1 = ((v >> 8) & 0x000F000Fu) | 0x64006400u;
+            const sycl::half2 p0 = sycl::fma(sycl::bit_cast<sycl::half2>(u0) - k1024, a2, c2);
+            const sycl::half2 p1 = sycl::fma(sycl::bit_cast<sycl::half2>(u1) - k1024, a2, c2);
+            w[4 * j + 0] = p0[0];
+            w[4 * j + 1] = p0[1];
+            w[4 * j + 2] = p1[0];
+            w[4 * j + 3] = p1[1];
+        }
+    }
+};
+
+// One lane's Q6_K block in the reorder layout: [ql 128][qh 64][scales 16][d] regions over all
+// blocks. Each 16-value tile has one int8 scale.
+struct xmx_block_q6_K {
+    static constexpr bool uses_table = false;
+
+    sycl::uint4 ql[8], qh[4], sc;
+    sycl::half  d;
+
+    void load(const uint8_t * base, size_t nblk, size_t bi) {
+        const sycl::uint4 * gql = (const sycl::uint4 *) base;
+        const sycl::uint4 * gqh = (const sycl::uint4 *) (base + (QK_K / 2) * nblk);
+        const sycl::uint4 * gsc = (const sycl::uint4 *) (base + (QK_K / 2 + QK_K / 4) * nblk);
+        const sycl::half *  gd  = (const sycl::half *) (base + (QK_K / 2 + QK_K / 4 + QK_K / 16) * nblk);
+#pragma unroll
+        for (int i = 0; i < 8; ++i) {
+            ql[i] = gql[bi * 8 + i];
+        }
+#pragma unroll
+        for (int i = 0; i < 4; ++i) {
+            qh[i] = gqh[bi * 4 + i];
+        }
+        sc = gsc[bi];
+        d  = gd[bi];
+    }
+
+    // the 16 weights of tile t (k = 16 t .. 16 t + 15), each group of 4 as (k0, k2, k1, k3). Tile t
+    // lies in half h of the block, quarter g of that half (ql low or high nibbles of the first or
+    // second 32 bytes, qh bits 2g), 16-value run lh.
+    void tile(int t, sycl::half * w) const {
+        const int         h = t / 8, g = (t % 8) / 2, lh = t % 2;
+        const int8_t      scale = ((const int8_t *) &sc)[8 * h + lh + 2 * g];
+        const sycl::half2 a2((sycl::half) ((float) d * scale)), k1056((sycl::half) 1056.0f);
+        const uint32_t *  ql32 = (const uint32_t *) ql;
+        const uint32_t *  qh32 = (const uint32_t *) qh;
+#pragma unroll
+        for (int j = 0; j < 4; ++j) {
+            // a 6-bit code | 0x6400 is the fp16 value 1024 + code; the weight is code - 32
+            const uint32_t qlw = ql32[16 * h + 8 * (g & 1) + 4 * lh + j];
+            const uint32_t qhw = qh32[8 * h + 4 * lh + j] >> (2 * g);
+            const uint32_t v   = (g >> 1) ? (qlw >> 4) : qlw;
+            const uint32_t u0  = (v & 0x000F000Fu) | ((qhw & 0x00030003u) << 4) | 0x64006400u;
+            const uint32_t u1  = ((v >> 8) & 0x000F000Fu) | (((qhw >> 8) & 0x00030003u) << 4) | 0x64006400u;
+            const sycl::half2 p0 = (sycl::bit_cast<sycl::half2>(u0) - k1056) * a2;
+            const sycl::half2 p1 = (sycl::bit_cast<sycl::half2>(u1) - k1056) * a2;
+            w[4 * j + 0] = p0[0];
+            w[4 * j + 1] = p0[1];
+            w[4 * j + 2] = p1[0];
+            w[4 * j + 3] = p1[1];
+        }
+    }
+};
+
+// One lane's IQ4_XS block in the plain layout (136 bytes: d, scales_h, scales_l[4], qs[128]);
+// IQ4_XS has no reorder layout. Sub-block s holds 32 values: the low nibbles of its 16 qs
+// bytes, then the high nibbles.
+struct xmx_block_iq4_xs {
+    // kvalues_iq4nl for both nibbles of a byte as an fp16 pair, low nibble first: one lookup
+    // in shared memory per two weights. Per-weight register lookups left the kernel ALU bound
+    // (1.7x slower than dp4a).
+    static constexpr bool uses_table = true;
+
+    static void fill_table(uint32_t * tab, int lid, int nthreads) {
+        for (int e = lid; e < 256; e += nthreads) {
+            const sycl::half2 h((sycl::half) (float) (int8_t) kvalue_iq4nl_u8(e & 0xF),
+                                (sycl::half) (float) (int8_t) kvalue_iq4nl_u8(e >> 4));
+            tab[e] = sycl::bit_cast<uint32_t>(h);
+        }
+    }
+
+    const uint32_t * tab;
+    uint32_t         v[sizeof(block_iq4_xs) / 4];
+
+    void load(const uint8_t * base, size_t /* nblk */, size_t bi) {
+        // blocks are 8-byte aligned (136 = 17 x 8)
+        const sycl::uint2 * src = (const sycl::uint2 *) (base + bi * sizeof(block_iq4_xs));
+#pragma unroll
+        for (int i = 0; i < (int) sizeof(block_iq4_xs) / 8; ++i) {
+            const sycl::uint2 u = src[i];
+            v[2 * i]            = u[0];
+            v[2 * i + 1]        = u[1];
+        }
+    }
+
+    // the 16 weights of tile t (k = 16 t .. 16 t + 15), each group of 4 as (k0, k2, k1, k3). The
+    // fields come out of the words by shifts: reading them through a block_iq4_xs pointer to
+    // this array breaks strict aliasing, and the compiler returned NaN.
+    void tile(int t, sycl::half * w) const {
+        const int         s        = t / 2, kt = t % 2;
+        const float       d        = sycl::bit_cast<sycl::half>((uint16_t) (v[0] & 0xFFFF));
+        const uint32_t    scales_h = v[0] >> 16;
+        const uint32_t    scales_l = (v[1] >> (8 * (s / 2))) & 0xFF;
+        const int         ls       = ((scales_l >> 4 * (s % 2)) & 0xF) | (((scales_h >> 2 * s) & 3) << 4);
+        const sycl::half2 dl2((sycl::half) (d * (ls - 32)));
+#pragma unroll
+        for (int j = 0; j < 4; ++j) {
+            // qs starts at byte 8; after the shift each byte's code is its low nibble
+            const uint32_t    q   = v[2 + 4 * s + j] >> (4 * kt);
+            const uint32_t    i02 = (q & 0xF) | ((q >> 12) & 0xF0);
+            const uint32_t    i13 = ((q >> 8) & 0xF) | ((q >> 20) & 0xF0);
+            const sycl::half2 p0  = sycl::bit_cast<sycl::half2>(tab[i02]) * dl2;
+            const sycl::half2 p1  = sycl::bit_cast<sycl::half2>(tab[i13]) * dl2;
+            w[4 * j + 0] = p0[0];
+            w[4 * j + 1] = p0[1];
+            w[4 * j + 2] = p1[0];
+            w[4 * j + 3] = p1[1];
+        }
+    }
+};
+
+// whether the XMX kernel for a type reads the reorder layout, else the plain block layout
+static bool xmx_reads_reorder(ggml_type type) {
+    return type != GGML_TYPE_IQ4_XS;
+}
