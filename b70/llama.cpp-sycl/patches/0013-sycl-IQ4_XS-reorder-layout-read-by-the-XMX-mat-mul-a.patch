     return true;
 }
 
+// IQ4_XS: [qs 128][d, scales_h, scales_l: the block's first 8 bytes] regions over all blocks. The
+// codes are then line-aligned. Only the XMX mat-mul reads this layout.
+static bool reorder_qw_iq4_xs(uint8_t * data_device, size_t size, dpct::queue_ptr stream) {
+    GGML_ASSERT(size % sizeof(block_iq4_xs) == 0);
+    static_assert(offsetof(block_iq4_xs, qs) == 8, "IQ4_XS header is the block's first 8 bytes");
+
+    const int nblocks = size / sizeof(block_iq4_xs);
+
+    sycl_reorder_temp_buffer tmp(stream, size);
+    if (!tmp) {
+        GGML_LOG_WARN("%s: failed to allocate %zu bytes for reorder temp buffer, skipping reorder\n", __func__, size);
+        return false;
+    }
+    uint8_t * tmp_buf = static_cast<uint8_t *>(tmp.ptr);
+
+    sycl::event copy_event;
+    SYCL_CHECK(CHECK_TRY_ERROR(copy_event = stream->memcpy(tmp_buf, data_device, size)));
+    if (!g_ggml_sycl_use_async_mem_op) {
+        copy_event.wait();
+    }
+
+    auto * qs_ptr  = data_device;
+    auto * hdr_ptr = qs_ptr + (QK_K / 2) * (size_t) nblocks;
+
+    auto reorder_event = stream->parallel_for(nblocks, [=](auto i) {
+        const block_iq4_xs * x  = (const block_iq4_xs *) tmp_buf;
+        const int            ib = i;
+
+        for (int j = 0; j < QK_K / 2; ++j) {
+            qs_ptr[(size_t) ib * (QK_K / 2) + j] = x[ib].qs[j];
+        }
+        const uint8_t * hdr = (const uint8_t *) &x[ib];
+        for (int j = 0; j < 8; ++j) {
+            hdr_ptr[(size_t) ib * 8 + j] = hdr[j];
+        }
+    });
+    if (!g_ggml_sycl_use_async_mem_op) {
+        reorder_event.wait_and_throw();
+    }
+    return true;
+}
