+// IQ4_XS in the reorder layout: [qs 128][d, scales_h, scales_l] regions over nblk blocks
+template <typename dst_t>
+static void dequantize_block_iq4_xs_reorder(const void * __restrict__ vx, dst_t * __restrict__ yy, const int64_t nblk,
+                                            const sycl::nd_item<3> & item_ct1) {
+    const int64_t   i   = item_ct1.get_group(2);
+    const uint8_t * qs  = (const uint8_t *) vx + i * (QK_K / 2);
+    const uint8_t * hdr = (const uint8_t *) vx + nblk * (QK_K / 2) + i * 8;
+
+    const int64_t tid = item_ct1.get_local_id(2);
+    const int64_t il  = tid / 8;  // 0...3
+    const int64_t ib  = tid % 8;  // 0...7
+    dst_t *       y   = yy + i * QK_K + 32 * ib + 4 * il;
+    const uint8_t * q4 = qs + 16 * ib + 4 * il;
+
+    const float    d        = *(const sycl::half *) hdr;
+    const uint16_t scales_h = hdr[2] | (hdr[3] << 8);
+    const float    dl       = d * ((((hdr[4 + ib / 2] >> 4 * (ib % 2)) & 0xf) | (((scales_h >> 2 * ib) & 3) << 4)) - 32);
+#pragma unroll
+    for (int j = 0; j < 4; ++j) {
+        y[j + 0]  = dl * kvalues_iq4nl[q4[j] & 0xf];
+        y[j + 16] = dl * kvalues_iq4nl[q4[j] >> 4];
+    }
+}
