-// whether the XMX path serves src0 x src1 once src0 is in the reorder layout: 4-8 f32 columns, and
-// 1-8 for IQ4_XS, whose reorder layout no dp4a kernel reads
+// the fewest columns this path takes for src0. From 1: IQ4_XS in its reorder layout, which no dp4a kernel
+// reads, and IQ3_S, whose dp4a kernel runs at a fifth of the read rate. From 2: Q3_K, whose multi-column
+// dp4a kernel already costs 3x its single column at 2. The rest from XMX_MIN_COLS.
+static int xmx_min_cols(const ggml_tensor * src0) {
+    const auto * extra = static_cast<const ggml_tensor_extra_gpu *>(src0->extra);
+    switch (src0->type) {
+        case GGML_TYPE_IQ4_XS:
+            return extra && extra->optimized_feature.reorder ? 1 : XMX_MIN_COLS;
+        case GGML_TYPE_IQ3_S:
+            return 1;
+        case GGML_TYPE_Q3_K:
+            return 2;
+        default:
+            return XMX_MIN_COLS;
+    }
+}
+
+// whether the XMX path serves src0 x src1 once src0 is in the layout it reads (see xmx_min_cols)
 static bool ggml_sycl_mul_mat_xmx_usable(ggml_backend_sycl_context & ctx, const ggml_tensor * src0,
                                          const ggml_tensor * src1) {
-    const auto * extra    = static_cast<const ggml_tensor_extra_gpu *>(src0->extra);
-    const bool   iq4_xs_reordered = src0->type == GGML_TYPE_IQ4_XS && extra && extra->optimized_feature.reorder;
-    const int    min_cols         = iq4_xs_reordered ? 1 : XMX_MIN_COLS;
-    return ggml_sycl_mul_mat_xmx_reads(ctx, src0) && src1->type == GGML_TYPE_F32 && src1->ne[1] >= min_cols &&
+    return ggml_sycl_mul_mat_xmx_reads(ctx, src0) && src1->type == GGML_TYPE_F32 && src1->ne[1] >= xmx_min_cols(src0) &&
            src1->ne[1] <= XMX_M && src1->ne[2] == 1 && src1->ne[3] == 1 && src1->nb[0] == sizeof(float);
 }
 
