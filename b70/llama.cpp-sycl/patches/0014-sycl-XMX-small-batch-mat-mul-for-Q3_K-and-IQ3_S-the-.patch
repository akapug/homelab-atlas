@@ -217,11 +218,125 @@ struct xmx_block_q6_K {
 
 // One lane's IQ4_XS block. Sub-block s holds 32 values: the low nibbles of its 16 qs bytes, then
 // the high nibbles.
+// One lane's Q3_K block in the reorder layout: [qs 64][hmask 32][scales 12][d] regions over all blocks.
+// A code is 2 bits of qs and 1 of hmask; the weight is code - 4, one 6-bit scale per 16 values.
+struct xmx_block_q3_K {
+    static constexpr int table_words = 0;  // no lookup table
+
+    sycl::uint4 qs[4], hm[2];
+    uint32_t    sc[3];
+    sycl::half  d;
+
+    void load(const uint8_t * base, size_t nblk, size_t bi) {
+        const sycl::uint4 * gqs = (const sycl::uint4 *) base;
+        const sycl::uint4 * ghm = (const sycl::uint4 *) (base + (QK_K / 4) * nblk);
+        const uint32_t *    gsc = (const uint32_t *) (base + (QK_K / 4 + QK_K / 8) * nblk);
+        const sycl::half *  gd  = (const sycl::half *) (base + (QK_K / 4 + QK_K / 8 + 12) * nblk);
+#pragma unroll
+        for (int i = 0; i < 4; ++i) {
+            qs[i] = gqs[bi * 4 + i];
+        }
+        hm[0] = ghm[bi * 2];
+        hm[1] = ghm[bi * 2 + 1];
+#pragma unroll
+        for (int i = 0; i < 3; ++i) {
+            sc[i] = gsc[bi * 3 + i];
+        }
+        d = gd[bi];
+    }
+
+    // the 16 weights of tile t (k = 16 t .. 16 t + 15), each group of 4 as (k0, k2, k1, k3). Tile t
+    // lies in half h of the block, bit pair j of its qs bytes (hmask bit 4 h + j), 16-value run lh.
+    void tile(int t, sycl::half * w) const {
+        const int       h = t / 8, j = (t % 8) / 2, lh = t % 2;
+        const int       is = 8 * h + 2 * j + lh, g = is / 4, b = is % 4;
+        const uint8_t * scb  = (const uint8_t *) sc;
+        const int       low4 = g < 2 ? (scb[4 * g + b] & 0xF) : (scb[4 * (g - 2) + b] >> 4);
+        const int       scale = (low4 | (((scb[8 + b] >> (2 * g)) & 3) << 4)) - 32;
+        const sycl::half2 a2((sycl::half) ((float) d * scale)), k1028((sycl::half) 1028.0f);
+        const uint32_t *  q32 = (const uint32_t *) qs;
+        const uint32_t *  h32 = (const uint32_t *) hm;
+#pragma unroll
+        for (int jj = 0; jj < 4; ++jj) {
+            // a 3-bit code | 0x6400 is the fp16 value 1024 + code; the weight is code - 4
+            const uint32_t qw = q32[8 * h + 4 * lh + jj] >> (2 * j);
+            const uint32_t hw = h32[4 * lh + jj] >> (4 * h + j);
+            const uint32_t u0 = (qw & 0x00030003u) | ((hw & 0x00010001u) << 2) | 0x64006400u;
+            const uint32_t u1 = ((qw >> 8) & 0x00030003u) | (((hw >> 8) & 0x00010001u) << 2) | 0x64006400u;
+            const sycl::half2 p0 = (sycl::bit_cast<sycl::half2>(u0) - k1028) * a2;
+            const sycl::half2 p1 = (sycl::bit_cast<sycl::half2>(u1) - k1028) * a2;
+            w[4 * jj + 0] = p0[0];
+            w[4 * jj + 1] = p0[1];
+            w[4 * jj + 2] = p1[0];
+            w[4 * jj + 3] = p1[1];
+        }
+    }
+};
+
+// One lane's IQ3_S block in the plain layout (110 bytes: d, qs[64], qh[8], signs[32], scales[4]); IQ3_S has
+// no reorder layout. Each 4 values are one of 512 grid entries (a 9-bit index), with 4 sign bits and a
+// scale per 32 values. The grid lives in shared memory as fp16 pairs in operand order.
+struct xmx_block_iq3_s {
+    static constexpr int  table_words = 2 * 512;
+
+    static void fill_table(uint32_t * tab, int lid, int nthreads) {
+        for (int e = lid; e < 512; e += nthreads) {
+            const uint32_t g = iq3s_grid[e];
+            tab[2 * e]       = sycl::bit_cast<uint32_t>(sycl::half2((sycl::half) (float) (g & 0xFF),
+                                                                    (sycl::half) (float) ((g >> 16) & 0xFF)));
+            tab[2 * e + 1]   = sycl::bit_cast<uint32_t>(sycl::half2((sycl::half) (float) ((g >> 8) & 0xFF),
+                                                                    (sycl::half) (float) (g >> 24)));
+        }
+    }
+
+    const uint32_t * tab;
+    uint16_t         u[sizeof(block_iq3_s) / 2];  // blocks are only 2-byte aligned
+
+    void load(const uint8_t * base, size_t /* nblk */, size_t bi) {
+        const uint16_t * src = (const uint16_t *) (base + bi * sizeof(block_iq3_s));
+#pragma unroll
+        for (int i = 0; i < (int) sizeof(block_iq3_s) / 2; ++i) {
+            u[i] = src[i];
+        }
+    }
+
+    uint32_t byte(int k) const { return (u[k / 2] >> (8 * (k % 2))) & 0xFF; }
+
+    // the 16 weights of tile t (k = 16 t .. 16 t + 15), each group of 4 as (k0, k2, k1, k3)
+    void tile(int t, sycl::half * w) const {
+        constexpr int     QS = 2, QH = QS + QK_K / 4, SIGNS = QH + QK_K / 32, SCALES = SIGNS + QK_K / 8;
+        const int         ib32 = t / 2, lh = t % 2;
+        const float       d    = sycl::bit_cast<sycl::half>(u[0]);
+        const uint32_t    qh   = byte(QH + ib32);
+        const sycl::half2 db2((sycl::half) (d * (1 + 2 * ((byte(SCALES + ib32 / 2) >> 4 * (ib32 % 2)) & 0xF))));
+#pragma unroll
+        for (int ll = 0; ll < 2; ++ll) {
+            const int      l = 2 * lh + ll;
+            const uint32_t s = byte(SIGNS + 4 * ib32 + l);
+#pragma unroll
+            for (int e = 0; e < 2; ++e) {
+                // grid entry e of this 8: bits 0-3 (e = 0) or 4-7 (e = 1) of s are its signs
+                const uint32_t idx = byte(QS + 8 * ib32 + 2 * l + e) | (((qh >> (2 * l + e)) & 1) << 8);
+                const uint32_t se  = s >> (4 * e);
+                const uint32_t m02 = ((se & 1) << 15) | (((se >> 2) & 1) << 31);
+                const uint32_t m13 = (((se >> 1) & 1) << 15) | (((se >> 3) & 1) << 31);
+                const sycl::half2 p0 = sycl::bit_cast<sycl::half2>(tab[2 * idx] ^ m02) * db2;
+                const sycl::half2 p1 = sycl::bit_cast<sycl::half2>(tab[2 * idx + 1] ^ m13) * db2;
+                const int         o  = 8 * ll + 4 * e;
+                w[o + 0] = p0[0];
+                w[o + 1] = p0[1];
+                w[o + 2] = p1[0];
+                w[o + 3] = p1[1];
+            }
+        }
+    }
+};
+
