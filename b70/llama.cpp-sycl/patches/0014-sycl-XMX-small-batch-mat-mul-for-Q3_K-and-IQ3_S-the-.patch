+    if (reordered != (src0->type != GGML_TYPE_IQ3_S) || dst->type != GGML_TYPE_F32 || dst->nb[0] != sizeof(float) ||
         !ggml_sycl_mul_mat_xmx_usable(ctx, src0, src1)) {
