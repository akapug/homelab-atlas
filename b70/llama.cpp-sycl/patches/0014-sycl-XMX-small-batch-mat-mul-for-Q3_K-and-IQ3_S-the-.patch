-        sycl::local_accessor<uint32_t, 1> tab(sycl::range<1>(block_t::uses_table ? 256 : 1), cgh);
+        sycl::local_accessor<uint32_t, 1> tab(sycl::range<1>(std::max(block_t::table_words, 1)), cgh);
