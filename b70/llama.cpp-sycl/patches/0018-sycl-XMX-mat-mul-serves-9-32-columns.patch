 // Lazily reorder supported MoE expert weights once their fused path is used.
+// 9-32 columns (a speculative verify step at several streams, or many streams): put src0 in the
+// layout the XMX mat-mul reads, since the first wide step can come before any narrow one (16
+// streams without speculation), then run it there. false leaves the call to the paths below.
+static bool ggml_sycl_mul_mat_xmx_wide(ggml_backend_sycl_context & ctx, const ggml_tensor * src0,
+                                       const ggml_tensor * src1, ggml_tensor * dst) {
+    if (src1->ne[1] <= 8 || !ggml_sycl_mul_mat_xmx_supports_type(src0->type)) {
+        return false;
+    }
+    opt_for_reorder(&ctx, src0, src1, dst, mul_mat_algo::MMVQ);
+    return ggml_sycl_mul_mat_xmx(ctx, src0, src1, dst);
+}
+
 static void opt_for_reorder_id(ggml_backend_sycl_context * ctx, const ggml_tensor * src0) {
     if (!g_ggml_sycl_enable_optimize || !ctx->opt_feature.reorder) {
         return;
@@ -4940,6 +4953,8 @@ static void ggml_sycl_mul_mat(ggml_backend_sycl_context & ctx, const ggml_tensor
         } else {
             ggml_sycl_op_mul_mat<quantize_q8_1>(ctx, src0, src1, dst, ggml_sycl_op_mul_mat_vec_q);
         }
+    } else if (!split && ggml_sycl_mul_mat_xmx_wide(ctx, src0, src1, dst)) {
+        // 9-32 columns on the XMX mat-mul
     } else if (use_mul_mat_q) {
         ggml_sycl_op_mul_mat<quantize_q8_1>(ctx, src0, src1, dst, ggml_sycl_op_mul_mat_q);
     } else {
