+
+#ifndef GGML_SYCL_MMVQ_XMX_HPP
+#define GGML_SYCL_MMVQ_XMX_HPP
+
+#include "common.hpp"
+
+// Weight types the XMX small-batch mat-mul dequantizes.
+bool ggml_sycl_mul_mat_xmx_supports_type(ggml_type type);
+
+// Whether the XMX path would serve src0 x src1 once src0 is in the reorder layout: 3-8
+// f32 columns, a 2-D non-split weight, a device with XMX. Callers use it to decline
+// fusions that would keep the weight out of that layout. src0 must not be a split buffer.
+bool ggml_sycl_mul_mat_xmx_usable(ggml_backend_sycl_context & ctx, const ggml_tensor * src0, const ggml_tensor * src1);
+
+// dst = src0 x src1 on the XMX engines. src0 must be in the reorder layout and not a split
+// buffer. Returns false, having done nothing, when this path does not serve the case.
+bool ggml_sycl_mul_mat_xmx(ggml_backend_sycl_context & ctx, const ggml_tensor * src0, const ggml_tensor * src1,
+                           ggml_tensor * dst);
+
+#endif  // GGML_SYCL_MMVQ_XMX_HPP
