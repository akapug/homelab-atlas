diff --git a/ggml/src/ggml-sycl/mmvq-xmx.cpp b/ggml/src/ggml-sycl/mmvq-xmx.cpp
new file mode 100644
index 0000000..9ccce2c
--- /dev/null
+++ b/ggml/src/ggml-sycl/mmvq-xmx.cpp
@@ -0,0 +1,242 @@
+//
+// MIT license
+// SPDX-License-Identifier: MIT
+//
+
+// Small-batch (2-8 column) quantized mat-mul on the XMX matrix engines.
+//
+// The dp4a mat-vec kernels do their int8 math on the vector units, so their cost grows with
+// the column count: at 4 or 8 columns they are compute bound, far from the weights' memory
+// floor. Here each sub-group owns 16 weight rows, dequantizes its 256-value blocks to fp16
+// straight into the B operand registers (a lane holds its own row), and multiplies them by an
+// fp16 copy of the activations padded to 8 rows. The time is then about the same at 2 and at
+// 8 columns. K is split across work-groups when there are too few row groups to keep the
+// card busy, and a second kernel sums the splits into dst.
+//
+// Two columns stay on the dp4a kernels: there the fused gate/up + GLU mat-vec, which this path
+// has to decline to reach the weights, is still faster end to end. A fused XMX gate/up kernel
+// measured slower than two plain launches plus the GLU op.
+
+#include "mmvq-xmx.hpp"
+
+#include "dequantize.hpp"
+
+#include <sycl/ext/oneapi/matrix/matrix.hpp>
+
+namespace sm = sycl::ext::oneapi::experimental::matrix;
+
+static constexpr int XMX_M          = 8;   // activation rows, padded; the tile height DPAS runs natively
+static constexpr int XMX_N          = 16;  // weight rows per sub-group (one per lane)
+static constexpr int XMX_K          = 16;  // fp16 values per tile along K
+static constexpr int XMX_SG         = 16;
+static constexpr int XMX_SGS_PER_WG = 4;
+static constexpr int XMX_MIN_COLS   = 3;
+// row groups x splits that ran fastest on an Arc Pro B70 (32 Xe cores); fewer leaves the
+// card idle, more over-subscribes it
+static constexpr int XMX_TARGET_SGS = 1280;
+
+// f32 activations -> fp16 [XMX_M][ncols], each group of 4 stored as (k0, k2, k1, k3) so that one
+// nibble mask of a weight word yields an fp16 pair in the B operand's order; rows >= ncols_y are 0
+static void xmx_convert_y(const float * x, sycl::half * y, int ncols, int ncols_y, int64_t stride_x,
+                          dpct::queue_ptr stream) {
+    const int ngroups = ncols / 4;
+    stream->parallel_for(sycl::range<2>(XMX_M, ngroups), [=](sycl::id<2> id) {
+        const int m = id[0], g = id[1];
+        sycl::vec<sycl::half, 4> v(0.0f);
+        if (m < ncols_y) {
+            const float * src = x + m * stride_x + 4 * g;
+            v = sycl::vec<sycl::half, 4>(src[0], src[2], src[1], src[3]);
+        }
+        *(sycl::vec<sycl::half, 4> *) (y + (size_t) m * ncols + 4 * g) = v;
+    });
+}
+
+// One lane's Q5_K block in the reorder layout: [qs 128][qh 32][scales 12][d, dmin] regions over all blocks.
+struct xmx_block_q5_K {
+    sycl::uint4 qs[8], qh[2];
+    uint32_t    sc[3];
+    sycl::half2 dm;
+
+    void load(const uint8_t * base, size_t nblk, size_t bi) {
+        const sycl::uint4 * gqs = (const sycl::uint4 *) base;
+        const sycl::uint4 * gqh = (const sycl::uint4 *) (base + (QK_K / 2) * nblk);
+        const uint32_t *    gsc = (const uint32_t *) (base + (QK_K / 2 + QK_K / 8) * nblk);
+        const sycl::half2 * gdm = (const sycl::half2 *) (base + (QK_K / 2 + QK_K / 8 + K_SCALE_SIZE) * nblk);
+#pragma unroll
+        for (int i = 0; i < 8; ++i) {
+            qs[i] = gqs[bi * 8 + i];
+        }
+        qh[0] = gqh[bi * 2];
+        qh[1] = gqh[bi * 2 + 1];
+#pragma unroll
+        for (int i = 0; i < 3; ++i) {
+            sc[i] = gsc[bi * 3 + i];
+        }
+        dm = gdm[bi];
+    }
+
+    // the 16 weights of tile t (k = 16 t .. 16 t + 15), each group of 4 as (k0, k2, k1, k3)
+    void tile(int t, sycl::half * w) const {
+        const int  s = t / 2, kt = t % 2, p = s / 2;
+        const bool hi = s % 2;
+        uint8_t    sc6, mn6;
+        get_scale_min_k4(s, (const uint8_t *) sc, sc6, mn6);
+        const float       d = dm[0], dmin = dm[1];
+        const sycl::half2 a2((sycl::half) (d * sc6)), c2((sycl::half) (-dmin * mn6)), k1024((sycl::half) 1024.0f);
+        const uint32_t *  qs32 = (const uint32_t *) qs;
+        const uint32_t *  qh32 = (const uint32_t *) qh;
+#pragma unroll
+        for (int j = 0; j < 4; ++j) {
+            // a 5-bit code | 0x6400 is the fp16 value 1024 + code
+            const int      k4 = 4 * kt + j;
+            const uint32_t ql = qs32[8 * p + k4], hh = qh32[k4] >> s;
+            const uint32_t v  = hi ? (ql >> 4) : ql;
+            const uint32_t u0 = (v & 0x000F000Fu) | ((hh & 0x00010001u) << 4) | 0x64006400u;
+            const uint32_t u1 = ((v >> 8) & 0x000F000Fu) | (((hh >> 8) & 0x00010001u) << 4) | 0x64006400u;
+            const sycl::half2 p0 = sycl::fma(sycl::bit_cast<sycl::half2>(u0) - k1024, a2, c2);
+            const sycl::half2 p1 = sycl::fma(sycl::bit_cast<sycl::half2>(u1) - k1024, a2, c2);
+            w[4 * j + 0] = p0[0];
+            w[4 * j + 1] = p0[1];
+            w[4 * j + 2] = p1[0];
+            w[4 * j + 3] = p1[1];
+        }
+    }
+};
+
+// dst = W y. With one split the sub-group writes dst itself; with several each writes
+// part[split] and xmx_reduce sums them.
+template <typename block_t>
+static void mul_mat_xmx(const void * vx, const sycl::half * y, float * part, float * dst, int ncols, int nrows,
+                        int ncols_y, int64_t stride_dst, int nsplit, dpct::queue_ptr stream) {
+    const int    nsg = nrows / XMX_N;
+    const int    nb  = ncols / QK_K;
+    const size_t nwg = (size_t) ((nsg + XMX_SGS_PER_WG - 1) / XMX_SGS_PER_WG) * nsplit;
+    stream->submit([&](sycl::handler & cgh) {
+        sycl::local_accessor<float, 1> slm(sycl::range<1>(XMX_SGS_PER_WG * XMX_M * XMX_N), cgh);
+        cgh.parallel_for(sycl::nd_range<1>(nwg * XMX_SGS_PER_WG * XMX_SG, XMX_SGS_PER_WG * XMX_SG),
+                         [=](sycl::nd_item<1> it) [[sycl::reqd_sub_group_size(XMX_SG)]] {
+            auto      sg    = it.get_sub_group();
+            const int lane  = sg.get_local_linear_id();
+            const int sgi   = sg.get_group_linear_id();
+            // the splits of one row group are dispatched next to each other
+            const int split = it.get_group(0) % nsplit;
+            const int gsg   = (it.get_group(0) / nsplit) * XMX_SGS_PER_WG + sgi;
+            if (gsg >= nsg) {
+                return;
+            }
+            const int       ib0 = split * nb / nsplit, ib1 = (split + 1) * nb / nsplit;
+            const int       row0 = gsg * XMX_N, row = row0 + lane;
+            const size_t    nblk    = (size_t) nrows * nb;
+            auto gy = sycl::address_space_cast<sycl::access::address_space::global_space, sycl::access::decorated::no>(y);
+
+            sm::joint_matrix<sycl::sub_group, float, sm::use::accumulator, XMX_M, XMX_N> mc;
+            sm::joint_matrix_fill(sg, mc, 0.0f);
+            // an element-wise apply on a never-written B hangs the GPU, so give it a value first
+            sm::joint_matrix<sycl::sub_group, sycl::half, sm::use::b, XMX_K, XMX_N, sm::layout::ext_intel_packed> mb;
+            sm::joint_matrix_fill(sg, mb, sycl::half(0.0f));
+
+            for (int ib = ib0; ib < ib1; ++ib) {
+                block_t blk;
+                blk.load((const uint8_t *) vx, nblk, (size_t) row * nb + ib);
+#pragma unroll
+                for (int t = 0; t < QK_K / XMX_K; ++t) {
+                    sm::joint_matrix<sycl::sub_group, sycl::half, sm::use::a, XMX_M, XMX_K, sm::layout::row_major> ma;
+                    sm::joint_matrix_load(sg, ma, gy + ib * QK_K + t * XMX_K, ncols);
+                    sycl::half wt[XMX_K];
+                    blk.tile(t, wt);
+                    // a lane holds column n = lane of B, and its i-th element is k = i
+                    int i = 0;
+                    sm::joint_matrix_apply(sg, mb, [&](sycl::half & x) { x = wt[i++]; });
+                    sm::joint_matrix_mad(sg, mc, ma, mb, mc);
+                }
+            }
+
+            if (nsplit > 1) {
+                auto gpart = sycl::address_space_cast<sycl::access::address_space::global_space,
+                                                      sycl::access::decorated::no>(
+                    part + (size_t) split * XMX_M * nrows + row0);
+                sm::joint_matrix_store(sg, mc, gpart, nrows, sm::layout::row_major);
+                return;
+            }
+            // one split: stage the tile through SLM and write the ncols_y real rows of dst
+            float * tile = &slm[sgi * XMX_M * XMX_N];
+            auto    lt   = sycl::address_space_cast<sycl::access::address_space::local_space, sycl::access::decorated::no>(tile);
+            sm::joint_matrix_store(sg, mc, lt, XMX_N, sm::layout::row_major);
+            sycl::group_barrier(sg);
+            for (int m = 0; m < ncols_y; ++m) {
+                dst[m * stride_dst + row] = tile[m * XMX_N + lane];
+            }
+        });
+    });
+}
+
+// dst[m][r] = sum over splits of part[split][m][r], for the ncols_y real rows
+static void xmx_reduce(const float * part, float * dst, int nrows, int ncols_y, int nsplit, int64_t stride_dst,
+                       dpct::queue_ptr stream) {
+    stream->parallel_for(sycl::range<2>(ncols_y, nrows), [=](sycl::id<2> id) {
+        const int m = id[0], r = id[1];
+        float     s = 0.0f;
+        for (int p = 0; p < nsplit; ++p) {
+            s += part[((size_t) p * XMX_M + m) * nrows + r];
+        }
+        dst[m * stride_dst + r] = s;
+    });
+}
+
+static int xmx_nsplit(int nrows, int ncols) {
+    const int nsg = nrows / XMX_N;
+    return std::max(1, std::min(ncols / QK_K, (XMX_TARGET_SGS + nsg / 2) / nsg));
+}
+
+bool ggml_sycl_mul_mat_xmx_supports_type(ggml_type type) {
+    return type == GGML_TYPE_Q5_K;
+}
+
+bool ggml_sycl_mul_mat_xmx_usable(ggml_backend_sycl_context & ctx, const ggml_tensor * src0, const ggml_tensor * src1) {
+    static int enabled = ggml_sycl_get_env("GGML_SYCL_XMX_MMVQ", 1);
+    if (!enabled || !ggml_sycl_mul_mat_xmx_supports_type(src0->type)) {
+        return false;
+    }
+    static std::vector<int> has_xmx(GGML_SYCL_MAX_DEVICES, -1);
+    if (has_xmx[ctx.device] < 0) {
+        auto & dev          = dpct::dev_mgr::instance().get_device(ctx.device);
+        has_xmx[ctx.device] = gpu_has_xmx(dev) && dev.has(sycl::aspect::fp16);
+    }
+    return has_xmx[ctx.device] && src1->type == GGML_TYPE_F32 && src1->ne[1] >= XMX_MIN_COLS &&
+           src1->ne[1] <= XMX_M && src1->ne[2] == 1 && src1->ne[3] == 1 && src1->nb[0] == sizeof(float) &&
+           ggml_is_contiguous(src0) && src0->ne[2] == 1 && src0->ne[3] == 1 && src0->ne[1] % XMX_N == 0 &&
+           src0->ne[0] % QK_K == 0;
+}
+
+bool ggml_sycl_mul_mat_xmx(ggml_backend_sycl_context & ctx, const ggml_tensor * src0, const ggml_tensor * src1,
+                           ggml_tensor * dst) {
+    const auto * extra = static_cast<const ggml_tensor_extra_gpu *>(src0->extra);
+    if (!extra || !extra->optimized_feature.reorder || dst->type != GGML_TYPE_F32 || dst->nb[0] != sizeof(float) ||
+        !ggml_sycl_mul_mat_xmx_usable(ctx, src0, src1)) {
+        return false;
+    }
+    scope_op_debug_print scope_dbg_print(__func__, dst, /*num_src=*/2, " : XMX");
+
+    const int             ncols   = src0->ne[0];
+    const int             nrows   = src0->ne[1];
+    const int             ncols_y = src1->ne[1];
+    const int64_t         ld      = dst->nb[1] / sizeof(float);
+    const int             nsplit  = xmx_nsplit(nrows, ncols);
+    const dpct::queue_ptr stream  = ctx.stream();
+    ggml_sycl_pool_alloc<sycl::half> y_alloc(ctx.pool(), (size_t) XMX_M * ncols);
+    ggml_sycl_pool_alloc<float>      part_alloc(ctx.pool(), nsplit > 1 ? (size_t) nsplit * XMX_M * nrows : 1);
+
+    xmx_convert_y((const float *) src1->data, y_alloc.get(), ncols, ncols_y, src1->nb[1] / sizeof(float), stream);
+    switch (src0->type) {
+        case GGML_TYPE_Q5_K:
+            mul_mat_xmx<xmx_block_q5_K>(src0->data, y_alloc.get(), part_alloc.get(), (float *) dst->data, ncols, nrows,
+                                        ncols_y, ld, nsplit, stream);
+            break;
+        default:
+            GGML_ABORT("unsupported type for the XMX mat-mul");
+    }
+    if (nsplit > 1) {
+        xmx_reduce(part_alloc.get(), (float *) dst->data, nrows, ncols_y, nsplit, ld, stream);
+    }
+    return true;
+}
