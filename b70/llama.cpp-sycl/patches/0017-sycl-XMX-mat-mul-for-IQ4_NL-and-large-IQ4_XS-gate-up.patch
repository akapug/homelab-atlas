From 6a47169336db31bd8abd0f52ced5448aad790412 Mon Sep 17 00:00:00 2001
From: akapug <akapug@users.noreply.github.com>
Date: Wed, 23 Sep 2026 20:11:27 +0000
Subject: [PATCH 17/17] sycl: XMX mat-mul for IQ4_NL, and large IQ4_XS gate/up pairs
 leave the fused dp4a kernel

IQ4_NL joins the XMX mat-mul, read in its reorder layout (Q4_0's: 8 blocks' codes are 128
contiguous bytes and their fp16 scales 16), with IQ4_XS's pair table.

IQ4_XS gate/up pairs large enough to take their reorder layout now leave the fused dp4a
gate/up + GLU kernel from 4 columns, like the other types. They stayed on it while one stream
meant one column, where the fused kernel is faster. With speculative decoding a step verifies
4-8 tokens even at one stream, and there the fused dp4a pair (332 us at 4 columns,
17408x5120) loses to two XMX launches and the GLU op (2 x 139).

Arc Pro B70, test-backend-ops perf, IQ4_NL, dp4a -> XMX, us at 4 / 8 columns:
  17408x5120 184 / 228 -> 140 / 142      5120x17408 190 / 247 -> 131 / 132
test-backend-ops MUL_MAT, MUL_MAT_VEC_FUSION and reorder-then-batch pass against the CPU; adds
IQ4_NL to the XMX cases and a large IQ4_XS gate/up + SWIGLU case at 1, 4 and 8 tokens.
---
 ggml/src/ggml-sycl/mmvq-xmx.cpp | 100 +++++++++++++++++++++++---------
 tests/test-backend-ops.cpp      |   7 ++-
 2 files changed, 79 insertions(+), 28 deletions(-)

diff --git a/ggml/src/ggml-sycl/mmvq-xmx.cpp b/ggml/src/ggml-sycl/mmvq-xmx.cpp
index 305145a..9d1f37e 100644
--- a/ggml/src/ggml-sycl/mmvq-xmx.cpp
+++ b/ggml/src/ggml-sycl/mmvq-xmx.cpp
@@ -3,7 +3,7 @@
 // SPDX-License-Identifier: MIT
 //
 
-// Small-batch (1-8 column) quantized mat-mul on the XMX matrix engines: Q3_K-Q6_K, IQ4_XS, IQ3_S.
+// Small-batch (1-8 column) quantized mat-mul on the XMX matrix engines: Q3_K-Q6_K, IQ4_XS, IQ4_NL, IQ3_S.
 //
 // The dp4a mat-vec kernels do their int8 math on the vector units, so their cost grows with
 // the column count: at 4 or 8 columns they are compute bound, far from the weights' memory
@@ -11,8 +11,8 @@
 // straight into the B operand registers (a lane holds its own row), and multiplies them by an
 // fp16 copy of the activations padded to 8 rows. The kernel time is then about the same at 4
 // and at 8 columns. K is split across work-groups when there are too few row groups to keep
-// the card busy, and a second kernel sums the splits into dst. The K-quants and IQ4_XS are read in
-// their reorder layouts; IQ4_XS's is read by this path alone, so it serves IQ4_XS from 1 column.
+// the card busy, and a second kernel sums the splits into dst. The K-quants, IQ4_XS and IQ4_NL are
+// read in their reorder layouts; IQ4_XS's is read by this path alone, so it serves IQ4_XS from 1 column.
 // IQ3_S, which has no reorder layout, is read in its plain blocks, also from 1 column.
 //
 // The fused gate/up + GLU dp4a mat-vec declines, so both weights come here, except for IQ4_XS
@@ -392,6 +392,46 @@ struct xmx_block_iq4_xs {
 };
 
 
+// One lane's run of 8 IQ4_NL blocks (256 values) in the reorder layout, which is Q4_0's: [qs 16 per
+// block][d per block] regions, so 8 blocks' codes are 128 contiguous bytes and their scales 16.
+// Block b holds the low nibbles of its 16 qs bytes, then the high nibbles.
+struct xmx_block_iq4_nl {
+    static constexpr int table_words = 256;
+
+    static void fill_table(uint32_t * tab, int lid, int nthreads) { xmx_block_iq4_xs::fill_table(tab, lid, nthreads); }
+
+    const uint32_t * tab;
+    sycl::uint4      qs[8];
+    sycl::uint4      d8;  // the 8 blocks' fp16 scales
+
+    void load(const uint8_t * base, size_t nblk, size_t bi) {
+        const sycl::uint4 * gqs = (const sycl::uint4 *) base;
+#pragma unroll
+        for (int i = 0; i < 8; ++i) {
+            qs[i] = gqs[bi * 8 + i];
+        }
+        d8 = ((const sycl::uint4 *) (base + (QK_K / 2) * nblk))[bi];
+    }
+
+    // the 16 weights of tile t (k = 16 t .. 16 t + 15), each group of 4 as (k0, k2, k1, k3)
+    void tile(int t, sycl::half * w) const {
+        const int         b = t / 2, kt = t % 2;
+        const sycl::half2 dl2(sycl::bit_cast<sycl::half>((uint16_t) (d8[b / 2] >> (16 * (b % 2)))));
+#pragma unroll
+        for (int j = 0; j < 4; ++j) {
+            const uint32_t    q   = qs[b][j] >> (4 * kt);
+            const uint32_t    i02 = (q & 0xF) | ((q >> 12) & 0xF0);
+            const uint32_t    i13 = ((q >> 8) & 0xF) | ((q >> 20) & 0xF0);
+            const sycl::half2 p0  = sycl::bit_cast<sycl::half2>(tab[i02]) * dl2;
+            const sycl::half2 p1  = sycl::bit_cast<sycl::half2>(tab[i13]) * dl2;
+            w[4 * j + 0] = p0[0];
+            w[4 * j + 1] = p0[1];
+            w[4 * j + 2] = p1[0];
+            w[4 * j + 3] = p1[1];
+        }
+    }
+};
+
 // dst = W y. With one split the sub-group writes dst itself; with several each writes
 // part[split] and xmx_reduce sums them. At most XMX_TARGET_SGS row groups run at once; the
 // sub-groups walk the rest in turn (a 248,320-row output head launched whole ran 1.3x slower
@@ -493,7 +533,7 @@ static int xmx_nsplit(int nrows, int ncols) {
 
 bool ggml_sycl_mul_mat_xmx_supports_type(ggml_type type) {
     return type == GGML_TYPE_Q3_K || type == GGML_TYPE_Q4_K || type == GGML_TYPE_Q5_K || type == GGML_TYPE_Q6_K ||
-           type == GGML_TYPE_IQ4_XS || type == GGML_TYPE_IQ3_S;
+           type == GGML_TYPE_IQ4_XS || type == GGML_TYPE_IQ4_NL || type == GGML_TYPE_IQ3_S;
 }
 
 // whether the XMX path can read src0 in its reorder layout: a supported type, a 2-D weight whose rows come
@@ -539,7 +579,8 @@ static int xmx_min_cols(const ggml_tensor * src0) {
 // whether the XMX path serves src0 x src1 once src0 is in the layout it reads (see xmx_min_cols)
 static bool ggml_sycl_mul_mat_xmx_usable(ggml_backend_sycl_context & ctx, const ggml_tensor * src0,
                                          const ggml_tensor * src1) {
-    return ggml_sycl_mul_mat_xmx_reads(ctx, src0) && src1->type == GGML_TYPE_F32 && src1->ne[1] >= xmx_min_cols(src0) &&
+    return ggml_sycl_mul_mat_xmx_reads(ctx, src0) && src1->type == GGML_TYPE_F32 &&
+           src1->ne[1] >= xmx_min_cols(src0) &&
            src1->ne[1] <= XMX_M && src1->ne[2] == 1 && src1->ne[3] == 1 && src1->nb[0] == sizeof(float);
 }
 
@@ -563,45 +604,50 @@ bool ggml_sycl_mul_mat_xmx(ggml_backend_sycl_context & ctx, const ggml_tensor *
     ggml_sycl_pool_alloc<sycl::half> y_alloc(ctx.pool(), (size_t) XMX_M * ncols);
     ggml_sycl_pool_alloc<float>      part_alloc(ctx.pool(), nsplit > 1 ? (size_t) nsplit * XMX_M * nrows : 1);
 
-    xmx_convert_y((const float *) src1->data, y_alloc.get(), ncols, ncols_y, src1->nb[1] / sizeof(float), stream);
+    sycl::half * y    = y_alloc.get();
+    float *      part = part_alloc.get();
+    float *      d    = (float *) dst->data;
+    xmx_convert_y((const float *) src1->data, y, ncols, ncols_y, src1->nb[1] / sizeof(float), stream);
     switch (src0->type) {
-        case GGML_TYPE_Q5_K:
-            mul_mat_xmx<xmx_block_q5_K>(src0->data, y_alloc.get(), part_alloc.get(), (float *) dst->data, ncols, nrows,
-                                        ncols_y, ld, nsplit, stream);
-            break;
         case GGML_TYPE_Q3_K:
-            mul_mat_xmx<xmx_block_q3_K>(src0->data, y_alloc.get(), part_alloc.get(), (float *) dst->data, ncols, nrows,
-                                        ncols_y, ld, nsplit, stream);
-            break;
-        case GGML_TYPE_IQ3_S:
-            mul_mat_xmx<xmx_block_iq3_s>(src0->data, y_alloc.get(), part_alloc.get(), (float *) dst->data, ncols, nrows,
-                                         ncols_y, ld, nsplit, stream);
+            mul_mat_xmx<xmx_block_q3_K>(src0->data, y, part, d, ncols, nrows, ncols_y, ld, nsplit, stream);
             break;
         case GGML_TYPE_Q4_K:
-            mul_mat_xmx<xmx_block_q4_K>(src0->data, y_alloc.get(), part_alloc.get(), (float *) dst->data, ncols, nrows,
-                                        ncols_y, ld, nsplit, stream);
+            mul_mat_xmx<xmx_block_q4_K>(src0->data, y, part, d, ncols, nrows, ncols_y, ld, nsplit, stream);
+            break;
+        case GGML_TYPE_Q5_K:
+            mul_mat_xmx<xmx_block_q5_K>(src0->data, y, part, d, ncols, nrows, ncols_y, ld, nsplit, stream);
             break;
         case GGML_TYPE_Q6_K:
-            mul_mat_xmx<xmx_block_q6_K>(src0->data, y_alloc.get(), part_alloc.get(), (float *) dst->data, ncols, nrows,
-                                        ncols_y, ld, nsplit, stream);
+            mul_mat_xmx<xmx_block_q6_K>(src0->data, y, part, d, ncols, nrows, ncols_y, ld, nsplit, stream);
             break;
         case GGML_TYPE_IQ4_XS:
-            mul_mat_xmx<xmx_block_iq4_xs>(src0->data, y_alloc.get(), part_alloc.get(), (float *) dst->data, ncols,
-                                          nrows, ncols_y, ld, nsplit, stream);
+            mul_mat_xmx<xmx_block_iq4_xs>(src0->data, y, part, d, ncols, nrows, ncols_y, ld, nsplit, stream);
+            break;
+        case GGML_TYPE_IQ4_NL:
+            mul_mat_xmx<xmx_block_iq4_nl>(src0->data, y, part, d, ncols, nrows, ncols_y, ld, nsplit, stream);
+            break;
+        case GGML_TYPE_IQ3_S:
+            mul_mat_xmx<xmx_block_iq3_s>(src0->data, y, part, d, ncols, nrows, ncols_y, ld, nsplit, stream);
             break;
         default:
             GGML_ABORT("unsupported type for the XMX mat-mul");
     }
     if (nsplit > 1) {
-        xmx_reduce(part_alloc.get(), (float *) dst->data, nrows, ncols_y, nsplit, ld, stream);
+        xmx_reduce(part, d, nrows, ncols_y, nsplit, ld, stream);
     }
     return true;
 }
 
 bool ggml_sycl_mul_mat_xmx_takes_glu_pair(ggml_backend_sycl_context & ctx, const ggml_tensor * gate_w,
                                           const ggml_tensor * up_w, const ggml_tensor * src1) {
-    // two XMX mat-muls and the GLU op beat the fused dp4a gate/up kernel, except for IQ4_XS:
-    // its fused dp4a pair (330 us at 4 columns, 17,408 x 5,120) beats two XMX launches (2 x 180)
-    return gate_w->type != GGML_TYPE_IQ4_XS && up_w->type != GGML_TYPE_IQ4_XS &&
-           ggml_sycl_mul_mat_xmx_usable(ctx, gate_w, src1) && ggml_sycl_mul_mat_xmx_usable(ctx, up_w, src1);
+    // Two XMX mat-muls and the GLU op beat the fused dp4a gate/up kernel from 4 columns. IQ4_XS
+    // weights only when large enough to take their reorder layout; with speculative decoding a
+    // step verifies 4-8 tokens even at one stream, where the fused dp4a IQ4_XS pair (332 us at 4
+    // columns, 17408 x 5120) loses to two XMX launches (2 x 139).
+    auto takes = [&](const ggml_tensor * w) {
+        return ggml_sycl_mul_mat_xmx_usable(ctx, w, src1) &&
+               (w->type != GGML_TYPE_IQ4_XS || ggml_sycl_mul_mat_xmx_takes_iq4_xs(ctx, w));
+    };
+    return takes(gate_w) && takes(up_w);
 }
diff --git a/tests/test-backend-ops.cpp b/tests/test-backend-ops.cpp
index 0f61939..e33bac8 100644
--- a/tests/test-backend-ops.cpp
+++ b/tests/test-backend-ops.cpp
@@ -10951,6 +10951,11 @@ static std::vector<std::unique_ptr<test_case>> make_test_cases_eval() {
     for (int64_t n : {1, 4, 8}) {
         test_cases.emplace_back(new test_mul_mat(GGML_TYPE_IQ4_XS, GGML_TYPE_F32, 8192, n, 4096, {1, 1}, {1, 1}));
     }
+    // a large IQ4_XS FFN pair leaves the fused dp4a kernel for two XMX mat-muls from 4 tokens
+    for (int64_t m_batch : {1, 4, 8}) {
+        test_cases.emplace_back(new test_mul_mat_vec_fusion(GGML_TYPE_IQ4_XS, GGML_GLU_OP_SWIGLU, m_batch, 8192, 4096, false,
+                                                            1, 1, false, false, true, false, {1, 1}));
+    }
 
     // flash attention at uneven GQA ratios (3, 5, 6, 7): packed into the next power of two
     for (int hs : {64, 128, 256}) {
@@ -10967,7 +10972,7 @@ static std::vector<std::unique_ptr<test_case>> make_test_cases_eval() {
     // small-batch XMX mat-mul: one K split (enough row groups) and several (few row groups, long K),
     // alone and as the FFN gate/up + GLU, which the fused dp4a path hands to it from 4 columns
     for (ggml_type type : {GGML_TYPE_Q3_K, GGML_TYPE_Q4_K, GGML_TYPE_Q5_K, GGML_TYPE_Q6_K, GGML_TYPE_IQ4_XS,
-                           GGML_TYPE_IQ3_S}) {
+                           GGML_TYPE_IQ4_NL, GGML_TYPE_IQ3_S}) {
         for (int64_t n_tok : {1, 2, 3, 5, 8}) {
             for (auto mk : std::vector<std::array<int64_t, 2>>{{4096, 256}, {64, 1024}}) {
                 test_cases.emplace_back(new test_mul_mat(type, GGML_TYPE_F32, mk[0], n_tok, mk[1], {1, 1}, {1, 1}));
