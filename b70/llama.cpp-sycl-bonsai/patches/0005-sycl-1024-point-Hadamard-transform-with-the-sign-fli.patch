From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: akapug <akapug@users.noreply.github.com>
Date: Sun, 27 Sep 2026 11:30:39 +0000
Subject: [PATCH 05/12] sycl: 1024-point Hadamard transform, with the sign flip
 fused in

Prism models rotate activations by a Hadamard transform in blocks of 1024
(prism.hadamard.block_size) before the folded weights. The SYCL fast
Walsh-Hadamard path stopped at 512, so each rotation fell back to an f32
oneMKL GEMM against the 1024x1024 matrix. Ternary Bonsai 2 27B does 258 of them
per token, 8.6 us each on an Arc Pro B70, plus a separate multiply by the sign
vector before each, 2.25 us.

The register FWHT now serves 1024 (64 floats per lane). The graph's
MUL(x, signs) -> RESHAPE -> MUL_MAT(hadamard) chain runs as one kernel that
multiplies by the signs as it loads, the chain the CUDA backend fuses.
GGML_SYCL_ENABLE_FUSION=0 turns the fusion off. Measured on the B70 with the
kernel in a stream of others: 2.2 us of device time per 1024-point transform.
---
 ggml/src/ggml-sycl/fwht.cpp      | 75 +++++++++++++++++++++++---------
 ggml/src/ggml-sycl/fwht.hpp      |  6 +++
 ggml/src/ggml-sycl/ggml-sycl.cpp | 26 +++++++++++
 3 files changed, 87 insertions(+), 20 deletions(-)

diff --git a/ggml/src/ggml-sycl/fwht.cpp b/ggml/src/ggml-sycl/fwht.cpp
index 2312b3d13..50ae82807 100644
--- a/ggml/src/ggml-sycl/fwht.cpp
+++ b/ggml/src/ggml-sycl/fwht.cpp
@@ -2,9 +2,12 @@
 
 #include <cmath>
 
-template <int N>
+// With has_signs, element e of row r is first multiplied by signs[(r % n_blk) * N + e]: a sign vector
+// spanning n_blk consecutive rows, as when a [width, n] activation is reshaped to [N, width / N * n].
+template <int N, bool has_signs>
 static void fwht_kernel(const float * __restrict__ src, float * __restrict__ dst, const int64_t n_rows,
-                        const float scale, const sycl::nd_item<2> & item) {
+                        const float scale, const float * __restrict__ signs, const int n_blk,
+                        const sycl::nd_item<2> & item) {
     const sycl::sub_group sg = item.get_sub_group();
 
     const int64_t r = item.get_global_id(0);
@@ -21,9 +24,13 @@ static void fwht_kernel(const float * __restrict__ src, float * __restrict__ dst
     float     reg[el_w];
     const int lane = sg.get_local_linear_id();
 
+    const float * signs_row = has_signs ? signs + (r % n_blk) * N : nullptr;
 #pragma unroll
     for (int i = 0; i < el_w; ++i) {
         reg[i] = src[i * WARP_SIZE + lane] * scale;
+        if constexpr (has_signs) {
+            reg[i] *= signs_row[i * WARP_SIZE + lane];
+        }
     }
 
     // Butterflies inside the sub-group. The partner of a lane with bit h clear is the
@@ -63,9 +70,9 @@ static void fwht_kernel(const float * __restrict__ src, float * __restrict__ dst
     }
 }
 
-template <int N>
+template <int N, bool has_signs>
 static void launch_fwht(const float * src, float * dst, const int64_t n_rows, const float scale,
-                        dpct::queue_ptr stream) {
+                        const float * signs, const int n_blk, dpct::queue_ptr stream) {
     constexpr int rows_per_block = 4;
 
     const int64_t num_blocks = (n_rows + rows_per_block - 1) / rows_per_block;
@@ -76,23 +83,35 @@ static void launch_fwht(const float * src, float * dst, const int64_t n_rows, co
 
     stream->parallel_for(sycl::nd_range<2>(global, local),
                          [=](sycl::nd_item<2> item) [[sycl::reqd_sub_group_size(WARP_SIZE)]] {
-                             fwht_kernel<N>(src, dst, n_rows, scale, item);
+                             fwht_kernel<N, has_signs>(src, dst, n_rows, scale, signs, n_blk, item);
                          });
 }
 
-bool ggml_sycl_op_fwht(ggml_backend_sycl_context & ctx, const ggml_tensor * src, ggml_tensor * dst) {
+// src holds the rows to transform (with signs, before the reshape to rows of n); dst is [n, rows].
+static bool fwht_dispatch(ggml_backend_sycl_context & ctx, const ggml_tensor * src, const ggml_tensor * signs_t,
+                          ggml_tensor * dst) {
     if (src->type != GGML_TYPE_F32 || dst->type != GGML_TYPE_F32) {
         return false;
     }
-    if (!ggml_are_same_shape(src, dst)) {
+    if (ggml_nelements(src) != ggml_nelements(dst)) {
         return false;
     }
     if (!ggml_is_contiguous(src) || !ggml_is_contiguous(dst)) {
         return false;
     }
 
-    const int     n    = (int) src->ne[0];
-    const int64_t rows = ggml_nrows(src);
+    const int     n    = (int) dst->ne[0];
+    const int64_t rows = ggml_nelements(dst) / n;
+
+    const float * signs = nullptr;
+    int           n_blk = 1;
+    if (signs_t) {
+        if (signs_t->type != GGML_TYPE_F32 || !ggml_is_contiguous(signs_t) || signs_t->ne[0] % n != 0) {
+            return false;
+        }
+        signs = (const float *) signs_t->data;
+        n_blk = (int) (signs_t->ne[0] / n);
+    }
 
     const float *   src_d  = (const float *) src->data;
     float *         dst_d  = (float *) dst->data;
@@ -100,20 +119,36 @@ bool ggml_sycl_op_fwht(ggml_backend_sycl_context & ctx, const ggml_tensor * src,
 
     const float scale = 1.0f / std::sqrt((float) n);
 
+    // one sub-group per row, N / WARP_SIZE values in each lane's registers: 1024 is 64 floats a lane,
+    // and 2048 would be 128, the whole register file, so it stays with the mat-mul
     switch (n) {
-        case 64:
-            launch_fwht<64>(src_d, dst_d, rows, scale, stream);
-            return true;
-        case 128:
-            launch_fwht<128>(src_d, dst_d, rows, scale, stream);
-            return true;
-        case 256:
-            launch_fwht<256>(src_d, dst_d, rows, scale, stream);
-            return true;
-        case 512:
-            launch_fwht<512>(src_d, dst_d, rows, scale, stream);
+#define FWHT_CASE(NN)                                                                         \
+        case NN:                                                                              \
+            if (signs) {                                                                      \
+                launch_fwht<NN, true>(src_d, dst_d, rows, scale, signs, n_blk, stream);       \
+            } else {                                                                          \
+                launch_fwht<NN, false>(src_d, dst_d, rows, scale, nullptr, 1, stream);        \
+            }                                                                                 \
             return true;
+        FWHT_CASE(64)
+        FWHT_CASE(128)
+        FWHT_CASE(256)
+        FWHT_CASE(512)
+        FWHT_CASE(1024)
+#undef FWHT_CASE
         default:
             return false;
     }
 }
+
+bool ggml_sycl_op_fwht(ggml_backend_sycl_context & ctx, const ggml_tensor * src, ggml_tensor * dst) {
+    if (!ggml_are_same_shape(src, dst)) {
+        return false;
+    }
+    return fwht_dispatch(ctx, src, nullptr, dst);
+}
+
+bool ggml_sycl_op_fwht_signed(ggml_backend_sycl_context & ctx, const ggml_tensor * src, const ggml_tensor * signs,
+                              ggml_tensor * dst) {
+    return fwht_dispatch(ctx, src, signs, dst);
+}
diff --git a/ggml/src/ggml-sycl/fwht.hpp b/ggml/src/ggml-sycl/fwht.hpp
index cd238cfaf..1fee478b5 100644
--- a/ggml/src/ggml-sycl/fwht.hpp
+++ b/ggml/src/ggml-sycl/fwht.hpp
@@ -9,4 +9,10 @@
 // ordinary mat-mul dispatch.
 bool ggml_sycl_op_fwht(ggml_backend_sycl_context & ctx, const ggml_tensor * src, ggml_tensor * dst);
 
+// The same transform with a sign flip fused in: dst = FWHT(src * signs), where signs spans src's
+// row (a multiple of dst's row length n) and src is the activation before its reshape to rows of n.
+// This is the MUL(x, signs) -> RESHAPE -> MUL_MAT(hadamard, .) chain that Prism models build.
+bool ggml_sycl_op_fwht_signed(ggml_backend_sycl_context & ctx, const ggml_tensor * src, const ggml_tensor * signs,
+                              ggml_tensor * dst);
+
 #endif  // GGML_SYCL_FWHT_HPP
diff --git a/ggml/src/ggml-sycl/ggml-sycl.cpp b/ggml/src/ggml-sycl/ggml-sycl.cpp
index d23f04609..0629c1c88 100644
--- a/ggml/src/ggml-sycl/ggml-sycl.cpp
+++ b/ggml/src/ggml-sycl/ggml-sycl.cpp
@@ -5732,6 +5732,28 @@ static int ggml_sycl_try_gdn_cache_fusion(const ggml_cgraph * cgraph, int node_i
     return skip;
 }
 
+// Prism's Hadamard-rotated activations build MUL(x, signs) -> RESHAPE -> MUL_MAT(hadamard, .) with the
+// Hadamard hint. The transform multiplies by the signs as it loads, so the MUL's pass over x goes away.
+// Returns false (nothing run) unless the whole chain is served.
+static bool ggml_sycl_try_fwht_signed(ggml_backend_sycl_context & ctx, const ggml_cgraph * cgraph, int i) {
+    if (!g_ggml_sycl_enable_fusion || i + 2 >= cgraph->n_nodes ||
+        !ggml_can_fuse_subgraph(cgraph, i, { GGML_OP_MUL, GGML_OP_RESHAPE, GGML_OP_MUL_MAT }, { i + 2 })) {
+        return false;
+    }
+    const ggml_tensor * mul     = cgraph->nodes[i];
+    const ggml_tensor * reshape = cgraph->nodes[i + 1];
+    ggml_tensor *       mm      = cgraph->nodes[i + 2];
+    const ggml_tensor * x       = mul->src[0];
+    const ggml_tensor * signs   = mul->src[1];
+
+    const bool pattern_ok = ggml_get_op_params_i32(mm, 1) == GGML_HINT_SRC0_IS_HADAMARD && mm->src[1] == reshape &&
+                            reshape->src[0] == mul && mul->type == GGML_TYPE_F32 && x->type == GGML_TYPE_F32 &&
+                            signs->type == GGML_TYPE_F32 && ggml_nrows(signs) == 1 && signs->ne[0] == x->ne[0] &&
+                            ggml_is_contiguous(x) && ggml_is_contiguous(signs) &&
+                            mm->src[0]->ne[0] == mm->ne[0] && signs->ne[0] % mm->ne[0] == 0;
+    return pattern_ok && ggml_sycl_op_fwht_signed(ctx, x, signs, mm);
+}
+
 static void ggml_backend_sycl_graph_compute_impl(ggml_backend_sycl_context * sycl_ctx, ggml_cgraph * cgraph) {
     ggml_sycl_set_main_device(sycl_ctx->device);
 
@@ -5767,6 +5789,10 @@ static void ggml_backend_sycl_graph_compute_impl(ggml_backend_sycl_context * syc
                 continue;
             }
         }
+        if (node->op == GGML_OP_MUL && ggml_sycl_try_fwht_signed(*sycl_ctx, cgraph, i)) {
+            i += 2;
+            continue;
+        }
         if (node->op == GGML_OP_RMS_NORM &&
             ggml_sycl_can_fuse(cgraph, i, { GGML_OP_RMS_NORM, GGML_OP_MUL }, {})) {
             ggml_sycl_op_rms_norm_fused(*sycl_ctx, node, cgraph->nodes[i + 1]);
