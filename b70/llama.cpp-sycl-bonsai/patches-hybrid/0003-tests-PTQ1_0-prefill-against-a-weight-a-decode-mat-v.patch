From 1ef76209c4f27e0759d05c3717c14fd9dd0fe6ca Mon Sep 17 00:00:00 2001
From: akapug <akapug@users.noreply.github.com>
Date: Sun, 27 Sep 2026 10:18:00 +0000
Subject: [PATCH 03/22] tests: PTQ1_0 prefill against a weight a decode mat-vec
 reordered

Backends that reorder a weight on its first single-token mat-vec then serve a
batch from the reordered layout, and no eval case ran that order, so a reordered
dequantize went untested. MUL_MAT_REORDER_THEN_BATCH runs one mat-vec and then a
batch against the same weight; the PTQ1_0 cases cover a whole and a partial row
group, 16 and 64 tokens, and the fp16 and fp32 dequantize paths.
---
 tests/test-backend-ops.cpp | 45 ++++++++++++++++++++++++++++++++++++++
 1 file changed, 45 insertions(+)

diff --git a/tests/test-backend-ops.cpp b/tests/test-backend-ops.cpp
index 4a5fb0bd7..a40236269 100644
--- a/tests/test-backend-ops.cpp
+++ b/tests/test-backend-ops.cpp
@@ -6528,6 +6528,41 @@ struct test_topk_moe : public test_case {
     }
 };
 
+// A weight used by one token and then by a batch, in that order: on backends that reorder a
+// weight on its first mat-vec, the batch then reads the reordered layout.
+struct test_mul_mat_reorder_then_batch : public test_case {
+    const ggml_type type;
+    const int64_t   m, k, n;
+    const bool      prec_f32;
+
+    std::string vars() override { return VARS_TO_STR5(type, m, k, n, prec_f32); }
+
+    double max_nmse_err() override { return 5e-4; }  // as test_mul_mat: q8_1 activations
+
+    std::string op_desc(ggml_tensor * t) override {
+        GGML_UNUSED(t);
+        return "MUL_MAT_REORDER_THEN_BATCH";
+    }
+
+    test_mul_mat_reorder_then_batch(ggml_type type = GGML_TYPE_Q4_0, int64_t m = 64, int64_t k = 256, int64_t n = 32,
+                                    bool prec_f32 = false)
+        : type(type), m(m), k(k), n(n), prec_f32(prec_f32) {}
+
+    ggml_tensor * build_graph(ggml_context * ctx) override {
+        ggml_tensor * w     = ggml_new_tensor_2d(ctx, type, k, m);
+        ggml_tensor * x1    = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, k, 1);
+        ggml_tensor * xn    = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, k, n);
+        ggml_tensor * one   = ggml_mul_mat(ctx, w, x1);   // first: the single-token mat-vec
+        ggml_tensor * batch = ggml_mul_mat(ctx, w, xn);   // then: the batch
+        if (prec_f32) {
+            ggml_mul_mat_set_prec(batch, GGML_PREC_F32);
+        }
+        ggml_tensor * out   = ggml_add(ctx, ggml_repeat(ctx, one, batch), batch);
+        ggml_set_name(out, "out");
+        return out;
+    }
+};
+
 struct test_mul_mat_vec_fusion : public test_case {
     const ggml_type type;
     const ggml_glu_op glu_op;
@@ -9452,6 +9487,16 @@ static std::vector<std::unique_ptr<test_case>> make_test_cases_eval() {
         }
     }
 
+    // prefill against a PTQ1_0 weight that a decode mat-vec already reordered, at a whole and a
+    // partial row group, through the fp16 and the fp32 dequantize
+    for (int64_t m : {64, 67}) {
+        for (int64_t n : {16, 64}) {
+            for (bool prec_f32 : {false, true}) {
+                test_cases.emplace_back(new test_mul_mat_reorder_then_batch(GGML_TYPE_PTQ1_0, m, 5120, n, prec_f32));
+            }
+        }
+    }
+
     // m == 1, with n on both sides of MMVF_MAX_BATCH_SIZE (8): mmvf below, operand swap above
     for (int64_t n : {1, 7, 8, 9, 16, 128, 512}) {
         test_cases.emplace_back(new test_mul_mat(GGML_TYPE_F32, GGML_TYPE_F32, 1, n, 2048, {1, 1}, {1, 1}));
-- 
