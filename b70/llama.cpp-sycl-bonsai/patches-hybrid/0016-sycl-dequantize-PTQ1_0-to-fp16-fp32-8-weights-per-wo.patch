From 27fedabcc2b9b7ec1fa77d4466784bee0754e3e6 Mon Sep 17 00:00:00 2001
From: akapug <akapug@users.noreply.github.com>
Date: Sun, 27 Sep 2026 13:48:11 +0000
Subject: [PATCH 16/22] sycl: dequantize PTQ1_0 to fp16/fp32 8 weights per
 work-item, in both layouts

A prefill ubatch (more than 8 tokens) dequantizes each PTQ1_0 weight to fp16 for the oneMKL
GEMM, and that pass cost as much as the GEMM. The loaded layout went through the generic
dequantize_block (2 weights per work-item, a branchy per-trit decode), the reorder layout one
work-item per 4-byte word storing its 20 weights one at a time, 32 bytes apart. Now 16
work-items write one 128-weight block, 8 consecutive weights (16 bytes) each, from the two
qs words of their trit plane (trit t of byte q: ((q * 3^t mod 256) * 3) >> 8) or the qh word.
Arc Pro B70, MUL_MAT ptq1_0 x f32, 512 columns: 17408x5120 1561 -> 1144 us, 5120x17408
1642 -> 1282 us, 10240x5120 931 -> 703 us (the loaded layout; the dequantize alone ~750 ->
~340 us at 17408x5120). Ternary Bonsai 2 27B pp2048 with the weights reordered (as served,
after the first decode): ubatch 512 682 -> 977 tok/s, 2048 1078 -> 1255 tok/s.
MUL_MAT ptq1_0 102/102, MUL_MAT_REORDER_THEN_BATCH 8/8, MUL_MAT_ID 75/75, GET_ROWS 4/4.
---
 ggml/src/ggml-sycl/convert.cpp | 105 ++++++++++++++++++++++++---------
 1 file changed, 77 insertions(+), 28 deletions(-)

diff --git a/ggml/src/ggml-sycl/convert.cpp b/ggml/src/ggml-sycl/convert.cpp
index f9a91e445..7d086644d 100644
--- a/ggml/src/ggml-sycl/convert.cpp
+++ b/ggml/src/ggml-sycl/convert.cpp
@@ -654,38 +654,87 @@ static void convert_unary_sycl(const void * vx, dst_t * y, const int64_t k, dpct
 }
 
 
+// PTQ1_0 to fp16/fp32, 8 consecutive weights per work-item, so that 16 work-items write one whole
+// block and a sub-group's stores coalesce (one weight per store, 20 of them per qs word, did not).
+// A block is 7 words in either layout: words 0..5 are qs (5 trits per byte), word 6 holds the 8 qh
+// trits in its low half (the loaded layout: the 2 qh bytes; the reorder layout: their 2-bit codes,
+// see ptq1_0_qh_codes) and d in its high half. Chunk c of a block (weights 8c..8c+7) is:
+//   c = 0..9:   trit plane c/2 of qs bytes 8(c%2)..8(c%2)+7 (words 2(c%2), 2(c%2)+1)
+//   c = 10..14: trit plane c-10 of qs bytes 16..23 (words 4, 5)
+//   c = 15:     the qh trits (word 6)
+// Trit t of byte q is (((q * 3^t) mod 256) * 3) >> 8, then minus 1.
+template <bool reordered, typename dst_t>
+static inline void dequantize_ptq1_0_chunk8(const uint32_t lo, const uint32_t hi, const uint32_t w6, const int c,
+                                            dst_t * __restrict__ yc) {
+    const float d = sycl::bit_cast<sycl::half>((uint16_t) (w6 >> 16));
+    float       v[8];
+    if (c < 15) {
+        const int      t = c < 10 ? c >> 1 : c - 10;
+        const uint32_t p = t == 0 ? 1 : t == 1 ? 3 : t == 2 ? 9 : t == 3 ? 27 : 81;  // 3^t
+#pragma unroll
+        for (int j = 0; j < 8; ++j) {
+            const uint32_t q = ((j < 4 ? lo >> (8 * j) : hi >> (8 * (j - 4))) & 0xFF) * p & 0xFF;
+            v[j]             = (float) ((int) ((q * 3) >> 8) - 1) * d;
+        }
+    } else {
+#pragma unroll
+        for (int e = 0; e < 8; ++e) {
+            uint32_t code;
+            if constexpr (reordered) {
+                const int pos = ((e & 1) << 3) | ((e & 2) << 1) | ((e & 4) >> 1);
+                code          = (w6 >> pos) & 3;
+            } else {
+                const uint32_t q = (w6 >> (8 * (e & 1))) & 0xFF;  // weight 120 + e is trit e/2 of qh[e%2]
+                const uint32_t p = (e >> 1) == 0 ? 1 : (e >> 1) == 1 ? 3 : (e >> 1) == 2 ? 9 : 27;
+                code             = ((q * p & 0xFF) * 3) >> 8;
+            }
+            v[e] = (float) ((int) code - 1) * d;
+        }
+    }
+    if constexpr (std::is_same_v<dst_t, sycl::half>) {
+        sycl::vec<sycl::half, 8> h;
+#pragma unroll
+        for (int j = 0; j < 8; ++j) {
+            h[j] = v[j];
+        }
+        *(sycl::vec<sycl::half, 8> *) yc = h;
+    } else {
+        *(sycl::float4 *) (yc + 0) = sycl::float4(v[0], v[1], v[2], v[3]);
+        *(sycl::float4 *) (yc + 4) = sycl::float4(v[4], v[5], v[6], v[7]);
+    }
+}
+
+// the loaded layout: consecutive 28-byte blocks
+template <typename dst_t>
+static void dequantize_row_ptq1_0_sycl(const void * vx, dst_t * y, const int64_t k, dpct::queue_ptr stream) {
+    const int64_t    nblocks = k / QK_PTQ1_0;
+    const uint32_t * x       = (const uint32_t *) vx;
+    stream->parallel_for(sycl::range<1>(nblocks * 16), [=](sycl::id<1> id) {
+        const int64_t    ib = id[0] / 16;
+        const int        c  = id[0] % 16;
+        const uint32_t * xb = x + ib * 7;
+        const int        w  = c < 10 ? 2 * (c & 1) : 4;
+        dequantize_ptq1_0_chunk8<false>(c < 15 ? xb[w] : 0, c < 15 ? xb[w + 1] : 0, xb[6], c, y + ib * QK_PTQ1_0 + 8 * c);
+    });
+}
+
+// the reorder layout (ggml_sycl_reordered::ptq1_0_layout): row groups of 16, word planes per block
 template <typename dst_t>
 void dequantize_ptq1_0_reorder_sycl(const void * vx, dst_t * y, const int64_t ncols, const int64_t nrows,
                                     dpct::queue_ptr stream) {
     using layout       = ggml_sycl_reordered::ptq1_0_layout;
     const int64_t    nb = ncols / QK_PTQ1_0;
     const uint32_t * x  = (const uint32_t *) vx;
-    // one work-item per word: a qs word holds 20 weights (5 trit planes of its 4 bytes), word 6 the last 8
-    stream->parallel_for(sycl::range<1>(nrows * nb * layout::words), [=](sycl::id<1> id) {
-        const int64_t  i   = id[0];
-        const int      w   = i % layout::words;
-        const int64_t  row = i / layout::words / nb;
-        const int64_t  b   = i / layout::words % nb;
-        const uint32_t v   = x[layout::word_index(row, b, w, nb, nrows)];
-        const uint32_t w6  = x[layout::word_index(row, b, 6, nb, nrows)];
-        const float    d   = sycl::bit_cast<sycl::half>((uint16_t) (w6 >> 16));
-        dst_t *        yb  = y + row * ncols + b * QK_PTQ1_0;
-        if (w < 6) {
-            for (int j = 0; j < 4; ++j) {
-                uint32_t q = (v >> (8 * j)) & 0xFF;
-                for (int t = 0; t < 5; ++t) {
-                    const uint32_t q3 = q * 3;
-                    const int      e  = w < 4 ? 16 * t + 4 * w + j : 80 + 8 * t + 4 * (w - 4) + j;
-                    yb[e]             = static_cast<dst_t>((float) ((int) (q3 >> 8) - 1) * d);
-                    q                 = q3 & 0xFF;
-                }
-            }
-        } else {
-            for (int e = 0; e < 8; ++e) {
-                const int pos = ((e & 1) << 3) | ((e & 2) << 1) | ((e & 4) >> 1);
-                yb[120 + e]   = static_cast<dst_t>((float) ((int) ((v >> pos) & 3) - 1) * d);
-            }
-        }
+    stream->parallel_for(sycl::range<1>(nrows * nb * 16), [=](sycl::id<1> id) {
+        const int64_t i   = id[0] / 16;
+        const int     c   = id[0] % 16;
+        const int64_t row = i / nb;
+        const int64_t b   = i % nb;
+        const int     w   = c < 10 ? 2 * (c & 1) : 4;
+        const uint32_t lo = c < 15 ? x[layout::word_index(row, b, w, nb, nrows)] : 0;
+        const uint32_t hi = c < 15 ? x[layout::word_index(row, b, w + 1, nb, nrows)] : 0;
+        dequantize_ptq1_0_chunk8<true>(lo, hi, x[layout::word_index(row, b, 6, nb, nrows)], c,
+                                       y + row * ncols + b * QK_PTQ1_0 + 8 * c);
     });
 }
 
@@ -704,7 +753,7 @@ to_fp16_sycl_t ggml_get_to_fp16_sycl(ggml_type type, ggml_tensor * dst) {
             if (ptq1_0_is_reordered(dst)) {
                 return nullptr;  // the reorder layout needs the row length: dequantize_ptq1_0_reorder_sycl
             }
-            return dequantize_block_sycl<QK_PTQ1_0, QR_PTQ1_0, dequantize_ptq1_0>;
+            return dequantize_row_ptq1_0_sycl;
         case GGML_TYPE_PQ2_0:
             return dequantize_block_sycl<QK_PQ2_0, QR_PQ2_0, dequantize_pq2_0>;
         case GGML_TYPE_Q2_0:
@@ -801,7 +850,7 @@ to_fp32_sycl_t ggml_get_to_fp32_sycl(ggml_type type, ggml_tensor *dst) {
             if (ptq1_0_is_reordered(dst)) {
                 return nullptr;  // the reorder layout needs the row length: dequantize_ptq1_0_reorder_sycl
             }
-            return dequantize_block_sycl<QK_PTQ1_0, QR_PTQ1_0, dequantize_ptq1_0>;
+            return dequantize_row_ptq1_0_sycl;
         case GGML_TYPE_PQ2_0:
             return dequantize_block_sycl<QK_PQ2_0, QR_PQ2_0, dequantize_pq2_0>;
