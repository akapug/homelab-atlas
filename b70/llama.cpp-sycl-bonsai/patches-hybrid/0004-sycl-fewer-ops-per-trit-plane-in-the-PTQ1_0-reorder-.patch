-static int ptq1_0_reorder_split(const int ngroups, const int nb) {
+// Sub-groups per row group (1-16, at least 2 blocks each). The launch should fit in one wave: one
+// just past a whole number of waves ends in a tail that runs on a fraction of the device. Within one
+// wave, about 5/8 of the sub-groups the device holds at once measured best. On a B70 (2048 resident)
+// with every weight read from memory: 5120x17408 split 1 (1088 sub-groups) 38.4 us, split 2 (2176)
+// 44.5; 17408x5120 split 4 (1280) 38.4, split 6 (1920) 38.6, split 7 (2240) 45.1, split 16 38.2 at
+// one column but 40.8 against 39.0 at two. GGML_SYCL_PTQ1_0_SPLIT overrides it.
+static int ptq1_0_reorder_split(const int ngroups, const int nb, const int resident_sgs) {
     static const int forced = [] {
         const char * e = getenv("GGML_SYCL_PTQ1_0_SPLIT");
         return e ? atoi(e) : 0;
@@ -1466,21 +1516,18 @@ static int ptq1_0_reorder_split(const int ngroups, const int nb) {
     if (forced > 0) {
         return forced;
     }
-    int ns = 1;
-    while (ns < 16 && ngroups * ns < 4096 && nb / (2 * ns) >= 4) {
-        ns *= 2;
-    }
-    return ns;
+    return std::max(1, std::min({ 16, nb / 2, resident_sgs * 5 / 8 / ngroups }));
 }
 
