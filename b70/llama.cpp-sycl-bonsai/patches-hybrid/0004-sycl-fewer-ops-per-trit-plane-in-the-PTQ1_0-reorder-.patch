+    constexpr uint32_t M  = 0x00FF00FFu;
+    constexpr uint32_t MH = 0xFF00FF00u;
+    constexpr bool     split_dot = ncols_dst <= 2;
+    // a full group's plane stride is a constant, so the 7 loads share one address
