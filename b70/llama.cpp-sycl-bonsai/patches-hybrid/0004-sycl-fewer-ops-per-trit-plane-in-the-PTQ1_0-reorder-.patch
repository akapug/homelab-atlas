+                        sumi[c][k]  = dpct::dp4a((int) we, e, sumi[c][k]);
+                        sumi[c][k]  = dpct::dp4a((int) wo, o, sumi[c][k]);
+                    }
+                } else {
+                    const int q = (int) (((we >> 8) & M) | (wo & MH));
 #pragma unroll
-                for (int c = 0; c < ncols_dst; ++c) {
-                    const int a = sycl::select_from_group(sg, j < 16 ? a0[c] : a1[c], j & 15);
-                    sumi[c][k]  = dpct::dp4a(q, a, sumi[c][k]);
+                    for (int c = 0; c < ncols_dst; ++c) {
+                        const int a = sycl::select_from_group(sg, j < 16 ? a0[c] : a1[c], j & 15);
+                        sumi[c][k]  = dpct::dp4a(q, a, sumi[c][k]);
+                    }
                 }
             }
         }
