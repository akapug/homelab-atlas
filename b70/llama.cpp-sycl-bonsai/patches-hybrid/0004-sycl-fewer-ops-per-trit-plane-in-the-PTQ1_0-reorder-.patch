+// and each dp4a takes its word by a constant-lane broadcast, which costs no instruction. The
+// sub-groups of a work-group split the group's blocks and add their sums in local memory.
+//
+// Decode: a qs word's even and odd bytes sit in 16-bit lanes, two bytes per multiply. After w = v * 3
+// each lane's high byte is the trit and its low byte the next plane's v. For one or two columns w goes
+// to dp4a unmasked, against an activation word whose bytes 0 and 2 are zero and whose bytes 1 and 3
+// hold the even (or the odd) elements: two dp4a per column instead of three ops to gather the four
+// trits into one word. From three columns the gathered word, shared by all, is cheaper. Trits are
+// dotted as 0..2; the -1 offset folds in through the q8_1 sums.
+template <int ncols_dst, bool full_group>
+static __dpct_inline__ void ptq1_0_reorder_rows(const uint32_t * __restrict__ xr, const char * __restrict__ vy,
+                                                const int ncols, const int stride_col_y_bytes, const int tw_runtime,
+                                                const int s, const int ns, const int l, const sycl::sub_group & sg,
+                                                float (&acc)[ncols_dst]) {
