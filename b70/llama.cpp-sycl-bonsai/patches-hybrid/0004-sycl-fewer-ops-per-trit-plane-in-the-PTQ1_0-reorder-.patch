+        int   ae1[split_dot ? ncols_dst : 1], ao1[split_dot ? ncols_dst : 1];
+        float d8[ncols_dst], ys[ncols_dst];
 #pragma unroll
         for (int c = 0; c < ncols_dst; ++c) {
