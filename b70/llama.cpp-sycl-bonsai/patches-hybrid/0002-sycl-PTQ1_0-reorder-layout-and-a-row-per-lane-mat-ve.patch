+// PTQ1_0 (28-byte blocks of 128 ternary weights: qs[24], qh[2], d) tiles its rows in groups of
+// 16, one row per sub-group lane in the mat-vec. Tile (g, b) holds block b of group g's rows as 7
+// planes of tw = min(16, nrows - 16 g) 32-bit words: word w of row 16 g + l is word
+// 112 nb g + 7 tw b + tw w + l, so a plane is one contiguous 64-byte read. Words 0-5 are the
+// block's qs bytes as they were; word 6 holds qh's 8 trits as 2-bit codes in its low half
+// (ptq1_0_qh_codes) and d in its high half. It is a permutation of the tensor's bytes, reordered
+// in place, and unlike the per-block layouts above it needs the row length to address.
+struct ptq1_0_layout {
+    static constexpr int rows  = 16;
+    static constexpr int words = 7;
+
+    static constexpr int64_t word_index(int64_t row, int64_t b, int w, int64_t nb, int64_t nrows) {
+        const int64_t g  = row / rows;
+        const int64_t tw = nrows - rows * g < rows ? nrows - rows * g : rows;
+        return rows * words * nb * g + words * tw * b + tw * w + row % rows;
+    }
+};
+
+// Element 120 + 2 n + h is trit n of qh[h] (n = 0..3). Its 2-bit code goes where, with
+// u = x | x << 12, the bytes of u & 0x03030303 are elements 120..123 and the bytes of
+// (u >> 2) & 0x03030303 are elements 124..127.
+static inline uint32_t ptq1_0_qh_codes(const uint8_t qh0, const uint8_t qh1) {
+    uint32_t x = 0;
+    for (int i = 0; i < 8; ++i) {
+        uint8_t q = i & 1 ? qh1 : qh0;
+        for (int n = 0; n < i >> 1; ++n) {
+            q = (uint8_t) (q * 3);
+        }
+        const uint32_t t   = ((uint32_t) q * 3) >> 8;
+        const int      pos = ((i & 1) << 3) | ((i & 2) << 1) | ((i & 4) >> 1);
+        x |= t << pos;
+    }
+    return x;
+}
