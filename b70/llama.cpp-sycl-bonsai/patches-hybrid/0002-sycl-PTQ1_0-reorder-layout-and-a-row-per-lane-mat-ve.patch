+template <typename dst_t>
+void dequantize_ptq1_0_reorder_sycl(const void * vx, dst_t * y, const int64_t ncols, const int64_t nrows,
+                                    dpct::queue_ptr stream) {
+    using layout       = ggml_sycl_reordered::ptq1_0_layout;
+    const int64_t    nb = ncols / QK_PTQ1_0;
+    const uint32_t * x  = (const uint32_t *) vx;
+    // one work-item per word: a qs word holds 20 weights (5 trit planes of its 4 bytes), word 6 the last 8
+    stream->parallel_for(sycl::range<1>(nrows * nb * layout::words), [=](sycl::id<1> id) {
+        const int64_t  i   = id[0];
+        const int      w   = i % layout::words;
+        const int64_t  row = i / layout::words / nb;
+        const int64_t  b   = i / layout::words % nb;
+        const uint32_t v   = x[layout::word_index(row, b, w, nb, nrows)];
+        const uint32_t w6  = x[layout::word_index(row, b, 6, nb, nrows)];
+        const float    d   = sycl::bit_cast<sycl::half>((uint16_t) (w6 >> 16));
+        dst_t *        yb  = y + row * ncols + b * QK_PTQ1_0;
+        if (w < 6) {
+            for (int j = 0; j < 4; ++j) {
+                uint32_t q = (v >> (8 * j)) & 0xFF;
+                for (int t = 0; t < 5; ++t) {
+                    const uint32_t q3 = q * 3;
+                    const int      e  = w < 4 ? 16 * t + 4 * w + j : 80 + 8 * t + 4 * (w - 4) + j;
+                    yb[e]             = static_cast<dst_t>((float) ((int) (q3 >> 8) - 1) * d);
+                    q                 = q3 & 0xFF;
+                }
+            }
+        } else {
+            for (int e = 0; e < 8; ++e) {
+                const int pos = ((e & 1) << 3) | ((e & 2) << 1) | ((e & 4) >> 1);
+                yb[120 + e]   = static_cast<dst_t>((float) ((int) ((v >> pos) & 3) - 1) * d);
+            }
+        }
+    });
+}
+
+template void dequantize_ptq1_0_reorder_sycl<sycl::half>(const void *, sycl::half *, int64_t, int64_t, dpct::queue_ptr);
+template void dequantize_ptq1_0_reorder_sycl<float>(const void *, float *, int64_t, int64_t, dpct::queue_ptr);
+
+static bool ptq1_0_is_reordered(const ggml_tensor * dst) {
+    return dst->src[0]->extra && ((ggml_tensor_extra_gpu *) dst->src[0]->extra)->optimized_feature.reorder;
+}
