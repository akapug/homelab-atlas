diff --git a/ggml/src/ggml-sycl/mmvq.cpp b/ggml/src/ggml-sycl/mmvq.cpp
index 36c4c1778..81a9f427a 100644
--- a/ggml/src/ggml-sycl/mmvq.cpp
+++ b/ggml/src/ggml-sycl/mmvq.cpp
@@ -1338,6 +1338,178 @@ static void mul_mat_vec_ptq1_0_q8_1_sycl_switch_ncols(
     }
 }
 
+// PTQ1_0 on its reorder layout (ggml_sycl_reordered::ptq1_0_layout). A sub-group takes a group of
+// 16 rows, one per lane, so each weight plane is one contiguous 64-byte read and every lane dots the
+// same activations: the sub-group reads a block's 128 quants once (lane l holds words l and 16 + l)
+// and each dp4a takes its word by a constant-lane broadcast. The sub-groups of a work-group split
+// the group's blocks and add their sums in local memory. Trits are decoded two bytes per 32-bit
+// multiply (even and odd bytes in separate 16-bit lanes) and dotted as 0..2; the -1 offset is
+// folded in through the q8_1 sums.
+template <int ncols_dst>
+static void mul_mat_vec_ptq1_0_q8_1_reorder(const uint32_t * __restrict__ vx, const char * __restrict__ vy,
+                                            float * __restrict__ dst, const int ncols, const int nrows,
+                                            const int stride_col_y_bytes, const int stride_col_dst,
+                                            float * __restrict__ slm, const sycl::nd_item<1> & it) {
+    constexpr int R = ggml_sycl_reordered::ptq1_0_layout::rows;
+    constexpr int W = ggml_sycl_reordered::ptq1_0_layout::words;
+    static_assert(R == WARP_SIZE, "one row per lane");
+
+    const auto sg = it.get_sub_group();
+    const int  l  = sg.get_local_linear_id();
+    const int  s  = sg.get_group_linear_id();
+    const int  ns = sg.get_group_linear_range();
+    const int  g  = it.get_group(0);
+    const int  nb = ncols / QK_PTQ1_0;
+    const int  tw = sycl::min(R, nrows - R * g);
+
+    // a lane past the end of a short last group reads the group's last row and drops the result
+    const uint32_t * xr = vx + (size_t) R * W * nb * g + sycl::min(l, tw - 1);
+
+    float acc[ncols_dst] = {};
+    for (int b = s; b < nb; b += ns) {
+        const uint32_t * xb = xr + (size_t) W * tw * b;
+        uint32_t         w[W];
+#pragma unroll
+        for (int i = 0; i < W; ++i) {
+            w[i] = xb[tw * i];
+        }
+
+        int   a0[ncols_dst], a1[ncols_dst];
+        float d8[ncols_dst], ys[ncols_dst];  // lane l: the (d, sum) of q8_1 sub-block l % 4
+#pragma unroll
+        for (int c = 0; c < ncols_dst; ++c) {
+            const char * yc = vy + (size_t) c * stride_col_y_bytes;
+            const int *  yq = (const int *) yc + 32 * b;
+            a0[c]           = yq[l];
+            a1[c]           = yq[16 + l];
+            const sycl::float2 ds =
+                ((const sycl::half2 *) (yc + ncols))[4 * b + (l & 3)].convert<float, sycl::rounding_mode::automatic>();
+            d8[c] = ds.x();
+            ys[c] = ds.y();
+        }
+
+        int sumi[ncols_dst][4] = {};
+        // qs word i < 4, trit plane t: elements 16 t + 4 i (activation word 4 t + i)
+        // qs word i = 4, 5, trit plane t: elements 80 + 8 t + 4 (i - 4) (activation word 20 + 2 t + i - 4)
+#pragma unroll
+        for (int i = 0; i < 6; ++i) {
+            uint32_t ve = w[i] & 0x00FF00FFu;
+            uint32_t vo = (w[i] >> 8) & 0x00FF00FFu;
+#pragma unroll
+            for (int t = 0; t < 5; ++t) {
+                // trit t of byte v is ((v * 3^t mod 256) * 3) >> 8: bits 8-9 of each 16-bit lane
+                const uint32_t we = ve * 3u;
+                const uint32_t wo = vo * 3u;
+                ve                = we & 0x00FF00FFu;
+                vo                = wo & 0x00FF00FFu;
+                const int q       = (int) (((we >> 8) & 0x00FF00FFu) | (wo & 0xFF00FF00u));
+                const int j       = i < 4 ? 4 * t + i : 20 + 2 * t + i - 4;
+                const int k       = i < 4 ? (t < 4 ? t / 2 : 2) : (t < 2 ? 2 : 3);
+#pragma unroll
+                for (int c = 0; c < ncols_dst; ++c) {
+                    const int a = sycl::select_from_group(sg, j < 16 ? a0[c] : a1[c], j & 15);
+                    sumi[c][k]  = dpct::dp4a(q, a, sumi[c][k]);
+                }
+            }
+        }
+
+        // word 6: elements 120..127 (activation words 30, 31) as 2-bit codes, and d
+        const uint32_t m  = w[6] & 0xFFFFu;
+        const uint32_t u  = m | (m << 12);
+        const int      qa = (int) (u & 0x03030303u);
+        const int      qb = (int) ((u >> 2) & 0x03030303u);
+        const float    d  = sycl::bit_cast<sycl::half>((uint16_t) (w[6] >> 16));
+#pragma unroll
+        for (int c = 0; c < ncols_dst; ++c) {
+            sumi[c][3] = dpct::dp4a(qa, sycl::select_from_group(sg, a1[c], 14), sumi[c][3]);
+            sumi[c][3] = dpct::dp4a(qb, sycl::select_from_group(sg, a1[c], 15), sumi[c][3]);
+            float v    = 0.0f;
+#pragma unroll
+            for (int k = 0; k < 4; ++k) {
+                v += sycl::select_from_group(sg, d8[c], k) * (float) sumi[c][k] - sycl::select_from_group(sg, ys[c], k);
+            }
+            acc[c] += d * v;
+        }
+    }
+
+    if (ns > 1) {
+#pragma unroll
+        for (int c = 0; c < ncols_dst; ++c) {
+            slm[(c * ns + s) * R + l] = acc[c];
+        }
+        sycl::group_barrier(it.get_group());
+        if (s != 0) {
+            return;
+        }
+#pragma unroll
+        for (int c = 0; c < ncols_dst; ++c) {
+            for (int s2 = 1; s2 < ns; ++s2) {
+                acc[c] += slm[(c * ns + s2) * R + l];
+            }
+        }
+    }
+    if (l < tw) {
+#pragma unroll
+        for (int c = 0; c < ncols_dst; ++c) {
+            dst[c * stride_col_dst + R * g + l] = acc[c];
+        }
+    }
+}
+
+// Sub-groups per row group: enough for about 4096 in all (the B70 holds 2048 at once), keeping at
+// least 4 blocks each. GGML_SYCL_PTQ1_0_SPLIT (a power of two, 1-16) overrides it for tuning.
+static int ptq1_0_reorder_split(const int ngroups, const int nb) {
+    static const int forced = [] {
+        const char * e = getenv("GGML_SYCL_PTQ1_0_SPLIT");
+        return e ? atoi(e) : 0;
+    }();
+    if (forced > 0) {
+        return forced;
+    }
+    int ns = 1;
+    while (ns < 16 && ngroups * ns < 4096 && nb / (2 * ns) >= 4) {
+        ns *= 2;
+    }
+    return ns;
+}
