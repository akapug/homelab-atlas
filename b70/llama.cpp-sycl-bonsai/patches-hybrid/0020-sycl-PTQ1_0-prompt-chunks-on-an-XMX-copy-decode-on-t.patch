+// A PTQ1_0 block is 7 words in either of its layouts: words 0..5 are qs (5 trits a byte), word 6 holds the 8 qh
+// trits in its low half and d in its high half. Element e is trit e / 16 of qs byte e % 16 for e < 80, trit
+// (e - 80) / 8 of qs byte 16 + e % 8 for e < 120, and trit (e - 120) / 2 of qh[e % 2] after that, where trit t of
+// byte q is ((q * 3^t mod 256) * 3) >> 8, the value plus one: its PQ2_0 code. The reorder layout keeps the qs words
+// as they are and stores the qh trits as 2-bit codes (ggml_sycl_reordered::ptq1_0_qh_codes).
+template <bool reordered>
+static inline uint32_t ptq1_0_code(const uint32_t (&w)[7], const int e) {
+    if (e >= 120 && reordered) {
+        const int n = e - 120;
+        return (w[6] >> (((n & 1) << 3) | ((n & 2) << 1) | ((n & 4) >> 1))) & 3;
+    }
+    const int byte = e < 80 ? e & 15 : e < 120 ? 16 + (e & 7) : 24 + ((e - 120) & 1);
+    const int t    = e < 80 ? e >> 4 : e < 120 ? (e - 80) >> 3 : (e - 120) >> 1;
+    uint32_t  q    = (w[byte >> 2] >> (8 * (byte & 3))) & 0xFF;
+    for (int i = 0; i < t; ++i) {
+        q = (q * 3) & 0xFF;
+    }
+    return (q * 3) >> 8;
+}
+
+// one work-item per block: dword j of its 32 qs bytes holds the codes of elements 16j..16j+15, lowest first
+template <bool reordered>
+static void pq2_xmx_from_ptq1_0(const uint32_t * x, uint32_t * qs, sycl::half * d, const int64_t nb,
+                                const int64_t nrows, dpct::queue_ptr stream) {
+    using layout = ggml_sycl_reordered::ptq1_0_layout;
+    stream->parallel_for(sycl::range<1>(nrows * nb), [=](sycl::id<1> id) {
+        const int64_t i = id[0];
+        uint32_t      w[layout::words];
 #pragma unroll
-                for (int k = 0; k < 4; ++k) {
-                    byte |= (uint8_t) ((ptq1_0_trit(x, 4 * j + k) + 1) << (2 * k));
-                }
-                qs[i * PQ2_XMX_QS_BYTES + j] = byte;
+        for (int k = 0; k < layout::words; ++k) {
+            w[k] = reordered ? x[layout::word_index(i / nb, i % nb, k, nb, nrows)] : x[i * layout::words + k];
+        }
+        for (int j = 0; j < PQ2_XMX_QS_DW; ++j) {
+            uint32_t v = 0;
+#pragma unroll
+            for (int k = 0; k < 16; ++k) {
+                v |= ptq1_0_code<reordered>(w, 16 * j + k) << (2 * k);
             }
-            d[i] = x->d;
-        }).wait();
-    }
+            qs[i * PQ2_XMX_QS_DW + j] = v;
+        }
+        d[i] = sycl::bit_cast<sycl::half>((uint16_t) (w[6] >> 16));
+    });
+}
 
