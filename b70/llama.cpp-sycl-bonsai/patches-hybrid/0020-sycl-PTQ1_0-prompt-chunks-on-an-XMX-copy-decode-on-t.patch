-// PQ2_0/PTQ1_0 weights on 16-wide DPAS devices are rewritten into the XMX layout on first use. From then on every
+// XMX copies of PTQ1_0 weights made so far: how many, their bytes, and the bytes of the weights they copy
+static std::atomic<int64_t> g_ggml_sycl_xmx_shadows{ 0 };
+static std::atomic<int64_t> g_ggml_sycl_xmx_shadow_bytes{ 0 };
+static std::atomic<int64_t> g_ggml_sycl_xmx_shadowed_bytes{ 0 };
+
+// The XMX copy of a PTQ1_0 weight, made on the first mul_mat that wants it, in a device allocation of its own that
+// the weight's extra owns (release_extra_gpu frees it). The weight's own bytes stay as they are, in their loaded
+// blocks or in the layout the row-per-lane mat-vec reordered them into, and the copy is made from either. nullptr
+// if it cannot be made; the weight then stays on the other paths for good.
+static const void * ggml_sycl_ptq1_xmx_shadow(ggml_backend_sycl_context & ctx, const ggml_tensor * src0,
+                                              ggml_tensor_extra_gpu * extra) {
+    if (extra->xmx_shadow != nullptr || extra->xmx_shadow_failed) {
+        return extra->xmx_shadow;
+    }
+    extra->xmx_shadow_failed = true;  // until the copy is made
+
+    const size_t    size  = ggml_sycl_ptq1_xmx_bytes(src0);
+    dpct::queue_ptr owner = ((ggml_backend_sycl_buffer_context *) src0->buffer->context)->stream;
+    void *          w     = ggml_sycl_malloc_device(size, *owner);
+    if (w == nullptr || (uintptr_t) w % 64 != 0) {
+        static std::atomic<bool> warned{ false };
+        if (!warned.exchange(true)) {
+            GGML_LOG_WARN("%s: no 64-byte aligned %zu bytes of device memory for the XMX copy of %s: it, and any other "
+                          "PTQ1_0 weight that gets no copy, stays on the other paths\n",
+                          __func__, size, src0->name);
+        }
+        ggml_sycl_free_device(w, *owner);
+        return nullptr;
+    }
+    if (!ggml_sycl_pq2_xmx_copy_ptq1_0(src0, extra->optimized_feature.reorder, w, ctx.stream())) {
+        ggml_sycl_free_device(w, *owner);
+        return nullptr;
+    }
+    extra->xmx_shadow        = w;
+    extra->xmx_shadow_stream = owner;
+    extra->xmx_shadow_failed = false;
+    g_ggml_sycl_xmx_shadows += 1;
+    g_ggml_sycl_xmx_shadow_bytes += (int64_t) size;
+    g_ggml_sycl_xmx_shadowed_bytes += (int64_t) ggml_nbytes(src0);
+    return w;
+}
+
+// After a graph that made XMX copies: their count and size, at info level the first time (once per process, in
+// practice after the first prompt), at debug level after that
+static void ggml_sycl_xmx_shadow_report() {
+    static std::atomic<int64_t> reported{ 0 };
+    const int64_t               n    = g_ggml_sycl_xmx_shadows.load();
+    const int64_t               prev = reported.exchange(n);
+    if (n == prev) {
+        return;
+    }
+    const double mib    = g_ggml_sycl_xmx_shadow_bytes.load() / (1024.0 * 1024.0);
+    const double of_mib = g_ggml_sycl_xmx_shadowed_bytes.load() / (1024.0 * 1024.0);
+    if (prev == 0) {
+        GGML_LOG_INFO("%s: XMX copies of %lld PTQ1_0 weights (%.1f MiB) for mul_mats of %d+ columns: %.1f MiB of "
+                      "device memory beside the weights\n",
+                      __func__, (long long) n, of_mib, ggml_sycl_xmx_min_rows(), mib);
+    } else {
+        GGML_LOG_DEBUG("%s: XMX copies of %lld PTQ1_0 weights (%.1f MiB) for mul_mats of %d+ columns: %.1f MiB of "
+                       "device memory beside the weights\n",
+                       __func__, (long long) n, of_mib, ggml_sycl_xmx_min_rows(), mib);
+    }
+}
