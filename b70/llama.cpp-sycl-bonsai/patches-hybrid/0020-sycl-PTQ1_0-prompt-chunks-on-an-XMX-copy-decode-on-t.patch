+    const int64_t    nrows = src0->ne[1];
+    const uint32_t * x     = (const uint32_t *) src0->data;
+    uint32_t *       qs    = (uint32_t *) dst;
+    sycl::half *     d     = (sycl::half *) ((uint8_t *) dst + nrows * nb * PQ2_XMX_QS_BYTES);
+    if (reordered) {
