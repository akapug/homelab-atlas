+static void mkl_fa_online_softmax_chunk(
+    dpct::queue_ptr stream,
+    float * __restrict KQ_f32,
+    sycl::half * __restrict S_f16,
+    float * __restrict KQ_max,
+    float * __restrict KQ_sum,
+    float * __restrict VKQ_accum,
+    int q0, int q_rows, int n_queries, int DV,
+    int chunk_size, int chunk_start,
+    int kvh_head,
+    const sycl::half * mask_data, int64_t mask_head_stride,
+    int64_t mask_row_stride, int mask_n_heads,
+    float logit_softcap) {
+    // float4/half4 loads: 16-byte aligned score rows and 8-byte aligned mask rows
+    const bool vec4 = chunk_size % 4 == 0 && chunk_start % 4 == 0 &&
+                      (!mask_data || ((uintptr_t) mask_data % 8 == 0 && mask_row_stride % 4 == 0 && mask_head_stride % 4 == 0));
+    if (vec4) {
+        mkl_fa_online_softmax_chunk_rows<true>(stream, KQ_f32, S_f16, KQ_max, KQ_sum, VKQ_accum, q0, q_rows, n_queries, DV,
+                                               chunk_size, chunk_start, kvh_head, mask_data, mask_head_stride,
+                                               mask_row_stride, mask_n_heads, logit_softcap);
+    } else {
+        mkl_fa_online_softmax_chunk_rows<false>(stream, KQ_f32, S_f16, KQ_max, KQ_sum, VKQ_accum, q0, q_rows, n_queries, DV,
+                                                chunk_size, chunk_start, kvh_head, mask_data, mask_head_stride,
+                                                mask_row_stride, mask_n_heads, logit_softcap);
+    }
 }
 
