+// q8_0 K/V (34-byte blocks: fp16 scale, 32 int8), dequantized straight into the XMX operand registers.
+// An operand register holds, per lane, one column of the tile (lane l: column l, element i: row i, as
+// joint_matrix_apply visits them on this device; test-backend-ops checks it), so
+// the products are arranged for each lane to read consecutive bytes of one KV cell:
+//   S = Q K^T    (Q from SLM as the A operand; K^T as the B operand: lane = cell, its 16 values = 16
+//                 consecutive dims of that cell's K row)
+//   O^T += V^T P^T  (V^T as the A operand: lane = cell, its 8 values = 8 consecutive dims of that cell's
+//                 V row; P^T from SLM as the B operand), so the O accumulators are dims x Q rows.
+template <int D>
+static void fattn_xmx_q8_0_kernel(const fx_params p, const sycl::nd_item<1> & it, char * slm) {
+    constexpr int MT = D / (FX_TM * FX_NSG);  // O^T tiles (8 dims each) per sub-group
+    static_assert(MT >= 1 && MT <= 4 && D % (FX_TM * FX_NSG) == 0, "head size must split over the sub-groups");
+    constexpr int QB = sizeof(block_q8_0);    // 34 bytes per 32 values
+    static_assert(D % QK8_0 == 0, "rows are whole q8_0 blocks");
+
+    auto      sg   = it.get_sub_group();
+    const int sgi  = sg.get_group_linear_id();
+    const int lane = sg.get_local_linear_id();
+    const int tid  = it.get_local_linear_id();
+
+    const int wg    = it.get_group(0);
+    const int grp   = wg % p.ngroups;
+    const int split = wg / p.ngroups % p.nsplit;
+    const int zk    = wg / p.ngroups / p.nsplit % p.nkvh;
+    const int seq   = wg / p.ngroups / p.nsplit / p.nkvh;
+    const int t0    = grp * p.tpg;
+    const int ntok  = sycl::min(p.tpg, p.ntok - t0);
+    const int nrows = ntok * p.gqa;
+
+    // SLM: Q [16][D] half | S [16][CH] float | P^T [CH][16] half | row rescale [16] | row (max, sum) [16] |
+    // live chunk marks; after the loop, O [16][D] float over Q and S
+    sycl::half *   Qs   = (sycl::half *) slm;
+    float *        S    = (float *) (Qs + D * FX_ROWS);
+    sycl::half *   PT   = (sycl::half *) (S + FX_ROWS * FX_CH);
+    float *        rs   = (float *) (PT + FX_ROWS * FX_CH);
+    sycl::float2 * stat = (sycl::float2 *) (rs + FX_ROWS);
+    int *          live = (int *) (stat + FX_ROWS);
+    float *        O    = (float *) slm;
+
+    for (int e = tid; e < D * FX_ROWS; e += FX_WG) {
+        const int r = e / D;
+        const int d = e % D;
+        float     v = 0.0f;
+        if (r < nrows) {
+            const int j = t0 + r / p.gqa;
+            const int h = zk * p.gqa + r % p.gqa;
+            v = *(const float *) (p.Q + seq * p.nb03 + h * p.nb02 + j * p.nb01 + d * sizeof(float)) * p.scale;
+        }
+        Qs[r * D + d] = (sycl::half) v;
+    }
+
+    const char *       Kb    = p.K + seq * p.nb13 + zk * p.nb12;
+    const char *       Vb    = p.V + seq * p.nb23 + zk * p.nb22;
+    const sycl::half * maskh = p.mask ? (const sycl::half *) (p.mask + p.nb33 * (seq % p.ne33)) : nullptr;
+    const int64_t      ldm   = p.nb31 / sizeof(sycl::half);
+
+    const int  sr      = 2 * sgi + lane / 8;
+    const int  sl      = lane % 8;
+    const bool sr_real = sr < nrows;
+    float      m_run   = -FLT_MAX / 2.0f;
+    float      l_run   = 0.0f;
+
+    const int d0 = sgi * MT * FX_TM;  // this sub-group's O dims
+    fx_acc_t  o0, o1, o2, o3;         // O^T: 8 dims x 16 Q rows each
+    sm::joint_matrix_fill(sg, o0, 0.0f);
+    sm::joint_matrix_fill(sg, o1, 0.0f);
+    sm::joint_matrix_fill(sg, o2, 0.0f);
+    sm::joint_matrix_fill(sg, o3, 0.0f);
+
+    const int nchunk = (p.chunks - split + p.nsplit - 1) / p.nsplit;
+    fattn_xmx_mark_live(p, sg, sgi, lane, maskh, ldm, t0, ntok, split, nchunk, live);
+
+    for (int i = 0; i < nchunk; ++i) {
+        const int k0 = (split + i * p.nsplit) * FX_CH;
+        sycl::group_barrier(it.get_group());
+        if (maskh && !live[i]) {
+            continue;
+        }
+
+        // S for this sub-group's 16 cells: lane = cell
+        {
+            fx_acc_t s0, s1;
+            sm::joint_matrix_fill(sg, s0, 0.0f);
+            sm::joint_matrix_fill(sg, s1, 0.0f);
+            const char * krow = Kb + (int64_t) (k0 + 16 * sgi + lane) * p.nb11;
+            fx_b_t       kb;
+            sm::joint_matrix_fill(sg, kb, sycl::half(0.0f));  // an apply on a never-written operand hangs the GPU
+#pragma unroll 2
+            for (int kt = 0; kt < D / FX_TK; ++kt) {
+                const char *     blk = krow + (kt * FX_TK / QK8_0) * QB;
+                const sycl::half d   = *(const sycl::half *) blk;
+                const uint16_t * q2  = (const uint16_t *) (blk + sizeof(sycl::half) + kt * FX_TK % QK8_0);
+                sycl::half       kv[FX_TK];
+#pragma unroll
+                for (int j = 0; j < FX_TK / 2; ++j) {
+                    const uint16_t w = q2[j];
+                    kv[2 * j + 0]    = d * (sycl::half) (int8_t) (w & 0xFF);
+                    kv[2 * j + 1]    = d * (sycl::half) (int8_t) (w >> 8);
+                }
+                int e = 0;  // element e of a lane is row e (dim d0 + e) of its column (cell)
+                sm::joint_matrix_apply(sg, kb, [&](sycl::half & x) { x = kv[e++]; });
+                fx_a_t qa;
+                sm::joint_matrix_load(sg, qa, fx_local(Qs + kt * FX_TK), D);
+                sm::joint_matrix_mad(sg, s0, qa, kb, s0);
+                sm::joint_matrix_load(sg, qa, fx_local(Qs + FX_TM * D + kt * FX_TK), D);
+                sm::joint_matrix_mad(sg, s1, qa, kb, s1);
+            }
+            sm::joint_matrix_store(sg, s0, fx_local(S + 16 * sgi), FX_CH, sm::layout::row_major);
+            sm::joint_matrix_store(sg, s1, fx_local(S + FX_TM * FX_CH + 16 * sgi), FX_CH, sm::layout::row_major);
+        }
+        sycl::group_barrier(it.get_group());
+
+        // online softmax of row sr over the chunk, P stored transposed: P^T[cell][row]
+        {
+            const sycl::half * mrow = maskh ? maskh + (t0 + (sr_real ? sr / p.gqa : 0)) * ldm + k0 : nullptr;
+            float              s[FX_CH / 8];
+            float              cmax = -INFINITY;
+#pragma unroll
+            for (int c = 0; c < FX_CH / 8; ++c) {
+                const int k = sl + 8 * c;
+                s[c]        = S[sr * FX_CH + k] + (mrow ? (float) mrow[k] : 0.0f);
+                cmax        = sycl::fmax(cmax, s[c]);
+            }
+#pragma unroll
+            for (int o = 4; o > 0; o >>= 1) {
+                cmax = sycl::fmax(cmax, sycl::permute_group_by_xor(sg, cmax, o));
+            }
+            const float m_new = sycl::fmax(m_run, cmax);
+            const float sc    = sycl::native::exp(m_run - m_new);
+            float       psum  = 0.0f;
+#pragma unroll
+            for (int c = 0; c < FX_CH / 8; ++c) {
+                const float e = sr_real ? sycl::native::exp(s[c] - m_new) : 0.0f;
+                PT[(sl + 8 * c) * FX_ROWS + sr] = (sycl::half) e;
+                psum += e;
+            }
+#pragma unroll
+            for (int o = 4; o > 0; o >>= 1) {
+                psum += sycl::permute_group_by_xor(sg, psum, o);
+            }
+            l_run = l_run * sc + psum;
+            m_run = m_new;
+            if (sl == 0) {
+                rs[sr] = sr_real ? sc : 1.0f;
             }
         }
+        sycl::group_barrier(it.get_group());
+
+        // O^T = O^T * rescale (per Q row: a column here) + V^T P^T over this sub-group's dims
+        const float rsc = rs[lane];  // a lane holds column lane (Q row) of each O^T tile
+        sm::joint_matrix_apply(sg, o0, [=](float & x) { x *= rsc; });
+        if constexpr (MT > 1) {
+            sm::joint_matrix_apply(sg, o1, [=](float & x) { x *= rsc; });
+        }
+        if constexpr (MT > 2) {
+            sm::joint_matrix_apply(sg, o2, [=](float & x) { x *= rsc; });
+            sm::joint_matrix_apply(sg, o3, [=](float & x) { x *= rsc; });
+        }
+        fx_a_t va;
+        sm::joint_matrix_fill(sg, va, sycl::half(0.0f));
+#pragma unroll 2
+        for (int kk = 0; kk < FX_CH / FX_TK; ++kk) {
+            fx_b_t pb;
+            sm::joint_matrix_load(sg, pb, fx_local(PT + kk * FX_TK * FX_ROWS), FX_ROWS);
+            const char * vrow = Vb + (int64_t) (k0 + kk * FX_TK + lane) * p.nb21;
+            // dims d0 + 8 t .. + 7 of this lane's cell into V^T, then O^T tile t += V^T P^T (a macro: the
+            // backend cannot pass a joint_matrix by reference)
+#define FX_Q8_0_PV(o, t)                                                                                   \
+            {                                                                                              \
+                const int        dd  = d0 + (t) * FX_TM;                                                   \
+                const char *     blk = vrow + (dd / QK8_0) * QB;                                           \
+                const sycl::half d   = *(const sycl::half *) blk;                                          \
+                const uint16_t * q2  = (const uint16_t *) (blk + sizeof(sycl::half) + dd % QK8_0);         \
+                sycl::half       vv[FX_TM];                                                                \
+                _Pragma("unroll") for (int j = 0; j < FX_TM / 2; ++j) {                                    \
+                    const uint16_t w = q2[j];                                                              \
+                    vv[2 * j + 0]    = d * (sycl::half) (int8_t) (w & 0xFF);                               \
+                    vv[2 * j + 1]    = d * (sycl::half) (int8_t) (w >> 8);                                 \
+                }                                                                                          \
+                int e = 0;                                                                                 \
+                sm::joint_matrix_apply(sg, va, [&](sycl::half & x) { x = vv[e++]; });                      \
