@@ -30,6 +32,7 @@ static constexpr int FX_SG   = 16;           // lanes per sub-group, the width o
 static constexpr int FX_NSG  = 8;            // sub-groups per work-group
 static constexpr int FX_WG   = FX_SG * FX_NSG;
 static constexpr int FX_ROWS = 16;           // Q rows per work-group (2 M tiles)
+static constexpr int FX_MAX_GROUPS = 4;      // row groups: more query tokens than fit 16 rows go to the tile kernel
 static constexpr int FX_CH   = 16 * FX_NSG;  // KV cells per chunk: 16 per sub-group
 static constexpr int FX_TM = 8, FX_TN = 16, FX_TK = 16;  // XMX tile: M x N accumulator, K deep
 
@@ -54,10 +57,54 @@ struct fx_params {
     sycl::float2 * dst_meta;  // nsplit > 1: (max, sum) per row and split
     float   scale;
     int     ntok, nqh, gqa, nkv, nkvh, nsplit, chunks;
+    int     tpg, ngroups;  // query tokens per row group (16 rows at most), row groups
     int64_t nb01, nb02, nb03, nb11, nb12, nb13, nb21, nb22, nb23, nb31, nb33;
     int     ne33;
 };
 
+// Marks the live chunks of a split: a chunk the mask hides (-inf) from every row adds nothing, and in a
+// unified KV cache most of the KV range can be other sequences' cells. One pass over the split's mask (a
+// sub-group per chunk, on the fp16 bits, which fast-math cannot fold away) lets the loop skip the rest
+// without touching memory.
+static inline void fattn_xmx_mark_live(const fx_params & p, const sycl::sub_group & sg, int sgi, int lane,
+                                       const sycl::half * maskh, int64_t ldm, int t0, int ntok, int split, int nchunk,
+                                       int * live) {
+    if (!maskh) {
+        return;
+    }
+    for (int i = sgi; i < nchunk; i += FX_NSG) {
+        const int k0 = (split + i * p.nsplit) * FX_CH;
+        bool      l  = false;
+        for (int e = lane; e < ntok * FX_CH; e += FX_SG) {
+            l = l || sycl::bit_cast<uint16_t>(maskh[(t0 + e / FX_CH) * ldm + k0 + e % FX_CH]) != 0xFC00;
+        }
+        l = sycl::any_of_group(sg, l);
+        if (lane == 0) {
+            live[i] = l;
+        }
+    }
+}
+
+// Writes the work-group's real Q rows of O [16][D] (SLM): normalized into dst with one split, else the
+// unnormalized split and its (max, sum) for flash_attn_combine_results.
+static inline void fattn_xmx_write(const fx_params & p, const float * O, const sycl::float2 * stat, int D, int nrows,
+                                   int seq, int zk, int t0, int split, int tid) {
+    for (int e = tid; e < nrows * D; e += FX_WG) {
+        const int     r     = e / D;
+        const int     d     = e % D;
+        const int64_t j_dst = ((int64_t) seq * p.ntok + t0 + r / p.gqa) * p.nqh + zk * p.gqa + r % p.gqa;
+        if (p.nsplit == 1) {
+            p.dst[j_dst * D + d] = O[r * D + d] / stat[r].y();
+        } else {
+            p.dst_tmp[(j_dst * p.nsplit + split) * D + d] = O[r * D + d];
+            if (d == 0) {
+                p.dst_meta[j_dst * p.nsplit + split] = stat[r];
+            }
+        }
+    }
+}
